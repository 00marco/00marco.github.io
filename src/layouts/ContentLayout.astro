---
import BaseLayout from "./BaseLayout.astro";
import PlantMark from "../components/PlantMark.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro?: string;
  updated?: string;
}

const { title, description, eyebrow, heading, intro, updated } = Astro.props;
---

<BaseLayout {title} {description}>
  <header class="content-header shell">
    <a class="brand" href="/" aria-label="LivingNotes home">
      <span class="brand-mark"><PlantMark size={32} /></span>
      <span>LivingNotes</span>
    </a>
    <a class="back-link" href="/">Back to home</a>
  </header>

  <main class="shell">
    <section class="page-heading">
      <p class="eyebrow"><span></span>{eyebrow}</p>
      <h1>{heading}</h1>
      {intro && <p class="intro">{intro}</p>}
      {updated && <p class="updated">Last updated {updated}</p>}
    </section>

    <article class="content-card">
      <slot />
    </article>
  </main>

  <footer class="content-footer shell">
    <a class="footer-brand" href="/"><PlantMark size={27} /><span>LivingNotes</span></a>
    <nav aria-label="Legal and support">
      <a href="/support/">Support</a>
      <a href="/terms/">Terms</a>
    </nav>
    <p>© {new Date().getFullYear()} LivingNotes</p>
  </footer>
</BaseLayout>

<style>
  .shell {
    width: min(920px, calc(100% - 48px));
    margin-inline: auto;
  }

  .content-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 92px;
    border-bottom: 1px solid var(--line);
  }

  .brand,
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: #485d49;
    background: #d9dfce;
    border-radius: 50%;
  }

  .back-link,
  .content-footer a {
    color: var(--ink-muted);
    font-size: 0.85rem;
    text-underline-offset: 5px;
  }

  .page-heading {
    max-width: 760px;
    padding: 112px 0 70px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    color: var(--sage-light);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 26px;
    height: 1px;
    background: currentColor;
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.7rem, 8vw, 6.4rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .intro {
    max-width: 650px;
    margin: 30px 0 0;
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .updated {
    margin: 20px 0 0;
    color: #7f8982;
    font-size: 0.78rem;
  }

  .content-card {
    padding: clamp(34px, 6vw, 68px);
    color: #d7dbd4;
    background: rgba(47, 51, 53, 0.82);
    border: 1px solid var(--line);
    border-radius: 30px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.2);
  }

  .content-card :global(section + section) {
    margin-top: 48px;
    padding-top: 48px;
    border-top: 1px solid var(--line);
  }

  .content-card :global(h2) {
    margin: 0 0 16px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.65rem, 3vw, 2.2rem);
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .content-card :global(h3) {
    margin: 28px 0 8px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
  }

  .content-card :global(p),
  .content-card :global(li) {
    color: var(--ink-muted);
    line-height: 1.75;
  }

  .content-card :global(p) {
    margin: 0;
  }

  .content-card :global(p + p) {
    margin-top: 16px;
  }

  .content-card :global(ul) {
    margin: 16px 0 0;
    padding-left: 1.3rem;
  }

  .content-card :global(a) {
    color: #dce8d4;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .content-card :global(.contact-button) {
    display: inline-flex;
    margin-top: 24px;
    padding: 15px 20px;
    color: #18221c;
    background: var(--ink);
    border-radius: 11px;
    font-weight: 600;
    text-decoration: none;
  }

  .content-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: 130px;
    margin-top: 80px;
    border-top: 1px solid var(--line);
    color: #7f8881;
    font-size: 0.76rem;
  }

  .footer-brand {
    color: #bec5bd;
    font-size: 0.88rem;
  }

  .content-footer nav {
    display: flex;
    gap: 22px;
  }

  .content-footer p {
    margin: 0;
    text-align: right;
  }

  @media (max-width: 620px) {
    .shell {
      width: min(100% - 30px, 540px);
    }

    .content-header {
      min-height: 76px;
    }

    .page-heading {
      padding: 80px 0 48px;
    }

    .content-card {
      border-radius: 22px;
    }

    .content-footer {
      grid-template-columns: 1fr auto;
    }

    .content-footer nav {
      grid-row: 2;
      grid-column: 1 / -1;
      padding-bottom: 28px;
    }
  }
</style>
