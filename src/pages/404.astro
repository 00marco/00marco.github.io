---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlantMark from "../components/PlantMark.astro";
---

<BaseLayout title="Page not found — LivingNotes" description="The page you were looking for could not be found.">
  <main>
    <div class="mark"><PlantMark size={72} /></div>
    <p>404</p>
    <h1>This thought wandered off.</h1>
    <a href="/">Return to LivingNotes</a>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    place-items: center;
    align-content: center;
    min-height: 100svh;
    padding: 30px;
    text-align: center;
  }

  .mark {
    color: #668166;
  }

  p {
    margin: 30px 0 12px;
    color: var(--sage-light);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 0 0 32px;
    font-family: var(--serif);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  a {
    color: var(--ink);
    text-underline-offset: 6px;
  }
</style>
