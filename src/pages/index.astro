---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlantMark from "../components/PlantMark.astro";
import { SITE_ASSETS } from "../config";

const title = "LivingNotes — Give unfinished ideas time to grow";
const description = "A calm place to set thoughts aside, let them develop, and return before they fade. Coming soon for iPhone and iPad.";

const collectionNames = [
  "Songs", "Research ideas", "Joke ideas", "Movies", "Books", "Scripts",
  "Lecture notes", "Journal", "Recipes", "Home projects", "To-do", "Poems",
  "Story seeds", "Characters", "Experiments", "Questions", "Quotes", "Sketches",
  "Essays", "Articles", "Podcast ideas", "Game ideas", "Designs", "Trips",
  "Gift ideas", "Reading list", "Watchlist", "Classes", "Work notes", "Dreams",
  "Memories", "Garden", "Repairs", "Finances", "Health", "Habits",
  "Goals", "Events", "Letters", "Photos", "Inventions", "Side projects",
  "Song fragments", "Thesis ideas", "Interview notes", "Worldbuilding", "Riffs", "Observations",
  "Problem list", "Learning notes", "Meal ideas", "Weekend plans", "Prototypes", "Writing prompts",
  "People", "Someday",
];

const plantCombinations = [0, 2, 3, 4, 5].flatMap((foliage) =>
  Array.from({ length: 5 }, (_, pot) => ({ foliage, pot })),
);

// Shuffle complete decks so every allowed design gets used before it repeats.
const shuffledPlantDeck = (seed: number) => {
  const deck = [...plantCombinations];
  let state = seed >>> 0;

  for (let index = deck.length - 1; index > 0; index -= 1) {
    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
    const swapIndex = state % (index + 1);
    [deck[index], deck[swapIndex]] = [deck[swapIndex], deck[index]];
  }

  return deck;
};

const collectionPlants = [
  ...shuffledPlantDeck(0x4c697669),
  ...shuffledPlantDeck(0x6e674e6f),
  ...shuffledPlantDeck(0x74657347),
]
  .slice(0, collectionNames.length)
  .map(({ foliage, pot }) => `/images/plants/plant_foliage-${foliage}_pot-${pot}_healthy.png`);

// A few fading plants hint at the decay mechanic without overwhelming the garden.
const decayingPlants = new Map([
  [5, 10],
  [16, 25],
  [29, 50],
  [35, 100],
  [50, 25],
]);

decayingPlants.forEach((decay, index) => {
  collectionPlants[index] = `/images/plants/plant_foliage-5_pot-4_decay-${decay}.png`;
});

const yellowingPlants = new Map([
  [8, "/images/plants/plant_foliage-2_pot-0_decay-25.png"],
  [14, "/images/plants/plant_foliage-3_pot-2_decay-25.png"],
  [20, "/images/plants/plant_foliage-4_pot-1_decay-25.png"],
  [27, "/images/plants/plant_foliage-5_pot-3_decay-25.png"],
  [32, "/images/plants/plant_foliage-3_pot-4_decay-50.png"],
  [33, "/images/plants/plant_foliage-4_pot-0_decay-50.png"],
  [44, "/images/plants/plant_foliage-2_pot-0_decay-25.png"],
  [52, "/images/plants/plant_foliage-4_pot-1_decay-25.png"],
]);

yellowingPlants.forEach((plant, index) => {
  collectionPlants[index] = plant;
});

const logoPlantPots = new Map([
  [2, 1],
  [12, 2],
  [23, 3],
  [34, 4],
  [47, 0],
  [54, 2],
]);

const decaySteps = [
  {
    title: "Notice the yellow",
    description: "A yellowing plant means its notes need attention.",
    image: SITE_ASSETS.decayWorkflow[0],
  },
  {
    title: "Hold to clear",
    description: "Press and hold the caterpillar to reveal the vowel.",
    note: "Your text is only hidden—it is never deleted or damaged.",
    image: SITE_ASSETS.decayWorkflow[2],
  },
  {
    title: "Clean again",
    description: "One vowel on each decaying card is covered every day.",
    image: SITE_ASSETS.decayWorkflow[3],
  },
];
---

<BaseLayout {title} {description}>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="LivingNotes home">
      <span class="brand-mark"><PlantMark size={32} /></span>
      <span>LivingNotes</span>
    </a>
    <a class="header-link" href="#inside">Inside the app</a>
  </header>

  <main id="top">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span> A place for thoughts to wait</p>
        <h1 id="hero-title">Some ideas need<br /><em>time to take root.</em></h1>
        <p class="lede">LivingNotes is a parking lot for unfinished thoughts—a place to keep songs, stories, research questions, and experiments without forcing them to be finished before they’re ready.</p>
        <div class="hero-actions">
          <p class="launch-badge"><small>In development</small>Coming soon</p>
        </div>
      </div>

      <div class="hero-visual reveal" aria-label="LivingNotes shown on iPhone">
        <div class="halo halo-one"></div>
        <div class="halo halo-two"></div>
        <figure class="phone-shot">
          <img src={SITE_ASSETS.heroPhone.src} alt={SITE_ASSETS.heroPhone.alt} width={SITE_ASSETS.heroPhone.width} height={SITE_ASSETS.heroPhone.height} fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="incubation" aria-labelledby="incubation-title">
      <div class="shell incubation-inner">
        <div class="incubation-copy">
          <p class="eyebrow eyebrow-dark"><span></span> Ideas don’t run on deadlines</p>
          <h2 id="incubation-title">You can’t rush a truly new idea.</h2>
          <p class="incubation-intro">Effort matters. But some things only become clear after you stop pushing: the missing lyric, the turn in a story, the research question worth asking, the experiment you haven’t quite found yet.</p>

          <div class="thought-examples" aria-label="Examples of ideas that need time">
            <span>A melody</span>
            <span>A story turn</span>
            <span>A research question</span>
            <span>An experiment</span>
          </div>
        </div>

        <ol class="workflow-steps">
          {decaySteps.map((step, index) => (
            <li class={`workflow-step workflow-step-${index + 1}`}>
              <figure class="workflow-shot">
                <img src={step.image.src} alt={step.image.alt} width={step.image.width} height={step.image.height} loading="lazy" />
                <figcaption class="workflow-callout">
                  <strong><span>{String(index + 1).padStart(2, "0")}</span>{step.title}</strong>
                  <span>{step.description}</span>
                  {step.note && <small>{step.note}</small>}
                </figcaption>
                {index === 1 && <p class="workflow-collection-callout">Each plant is a collection of notes.</p>}
              </figure>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="product-section shell" id="inside" aria-labelledby="inside-title">
      <div class="section-heading">
        <p class="eyebrow"><span></span> The card is the container</p>
        <h2 id="inside-title">Unfinished thoughts,<br />given a shape.</h2>
        <p>Cards keep ideas distinct without isolating them. Add what you know, leave room for what you don’t, and see the whole collection at once.</p>
      </div>

      <div class="plant-field-window" role="img" aria-label="An expansive grid of LivingNotes plants continuing beyond the visible area">
        <div class="plant-field" aria-hidden="true">
          {collectionNames.map((name, index) => (
            <span class="collection-plant">
            {logoPlantPots.has(index) ? (
              <span class="logo-plant">
                <svg viewBox="0 0 624 648" fill="none">
                  <g transform="translate(139 218) scale(7.2)">
                    <path d="M24 35V18" stroke="#76513d" stroke-width="2.5" stroke-linecap="round" />
                    <path d="M24 26C17 26 12.5 22.3 12.5 16.2C19.3 15.4 23.8 18.8 24 26Z" fill="#76956f" />
                    <path d="M24 21.5C24.4 14.4 28.7 10.3 35.7 10.5C35.8 17 31.7 21.2 24 21.5Z" fill="#9ab08b" />
                    <path d="M24 18.5C21.1 15.9 21.3 12.5 23.4 9.2C26.8 11.4 27.7 14.8 24 18.5Z" fill="#b7c7a8" transform="rotate(-30 24 18.5)" />
                  </g>
                </svg>
                <img
                  src={`/images/plants/plant_foliage-0_pot-${logoPlantPots.get(index)}_healthy.png`}
                  alt=""
                  width="624"
                  height="648"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : (
              <img src={collectionPlants[index]} alt="" width="624" height="648" loading="lazy" decoding="async" />
            )}
            <small>{name}</small>
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="closing shell" aria-labelledby="closing-title">
      <div class="closing-mark" aria-hidden="true"><PlantMark size={82} /></div>
      <p class="eyebrow centered"><span></span> Begin with a thought <span></span></p>
      <h2 id="closing-title">Not every thought needs<br />an answer today.</h2>
      <p>LivingNotes is coming soon for iPhone and iPad.</p>
      <p class="launch-badge launch-badge-light"><small>In development</small>Coming soon</p>
    </section>
  </main>

  <footer class="site-footer shell">
    <a class="brand footer-brand" href="#top"><PlantMark size={27} /><span>LivingNotes</span></a>
    <nav class="footer-links" aria-label="Support and legal">
      <a href="/support/">Support</a>
      <a href="/terms/">Terms</a>
    </nav>
    <p>© {new Date().getFullYear()} LivingNotes</p>
  </footer>
</BaseLayout>

<style>
  .shell {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 92px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: #485d49;
    background: #d9dfce;
    border-radius: 50%;
  }

  .header-link {
    color: var(--ink-muted);
    font-size: 0.9rem;
    text-underline-offset: 5px;
    transition: color 160ms ease;
  }

  .header-link:hover {
    color: var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
    min-height: 650px;
    padding-block: 48px 62px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    color: var(--sage-light);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .eyebrow > span {
    display: block;
    width: 26px;
    height: 1px;
    background: currentColor;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.99;
  }

  h1 {
    max-width: 720px;
    font-size: clamp(3.3rem, 5.5vw, 5.6rem);
  }

  h1 em {
    color: var(--sage-light);
    font-weight: 400;
  }

  .lede {
    max-width: 540px;
    margin: 34px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 38px;
  }

  .launch-badge {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 62px;
    padding: 11px 20px;
    color: #18221c;
    background: var(--ink);
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    gap: 3px;
    margin: 0;
  }

  .launch-badge small {
    color: #58625b;
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 540px;
  }

  .halo {
    position: absolute;
    border: 1px solid rgba(168, 190, 158, 0.13);
    border-radius: 50%;
  }

  .halo-one {
    width: 520px;
    height: 520px;
  }

  .halo-two {
    width: 400px;
    height: 400px;
  }

  .phone-shot {
    position: relative;
    z-index: 2;
    width: min(285px, 62%);
    margin: 0;
    padding: 9px;
    background: #111513;
    border: 1px solid rgba(236, 239, 230, 0.25);
    border-radius: 44px;
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.45);
    transform: rotate(4deg);
    transform-origin: 50% 60%;
    overflow: hidden;
  }

  .phone-shot img {
    border-radius: 35px;
  }

  .incubation {
    color: #26302a;
    background:
      radial-gradient(circle at 50% 42%, rgba(155, 202, 161, 0.2), transparent 24rem),
      #f7f5ef;
  }

  .incubation-inner {
    padding-block: 82px 104px;
  }

  .eyebrow-dark {
    justify-content: center;
    color: #68816a;
  }

  .incubation-copy {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }

  .incubation h2 {
    max-width: 720px;
    margin-inline: auto;
    color: #262a27;
    font-size: clamp(2.35rem, 4vw, 4.2rem);
    line-height: 0.98;
  }

  .incubation-intro {
    max-width: 620px;
    margin: 22px auto 0;
    color: #606761;
    font-size: clamp(0.96rem, 1.25vw, 1.08rem);
    line-height: 1.55;
  }

  .thought-examples {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 24px 0 0;
  }

  .thought-examples span {
    padding: 7px 11px;
    color: #526454;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(67, 91, 71, 0.14);
    border-radius: 999px;
    font-size: 0.72rem;
  }

  .workflow-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 28px);
    margin: 64px 0 0;
    padding: 0;
    list-style: none;
  }

  .workflow-step {
    position: relative;
    min-width: 0;
  }

  .workflow-shot {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 470px;
    margin: 0;
  }

  .workflow-shot img {
    display: block;
    width: min(215px, 56%);
    aspect-ratio: 917 / 1715;
    object-fit: contain;
    filter: drop-shadow(0 24px 28px rgba(28, 36, 30, 0.18));
  }

  .workflow-callout {
    position: absolute;
    z-index: 1;
    width: min(112px, 30%);
    color: #527158;
    font-size: 0.72rem;
    line-height: 1.38;
  }

  .workflow-callout strong,
  .workflow-callout > span,
  .workflow-callout small {
    display: block;
  }

  .workflow-callout strong {
    margin-bottom: 5px;
    color: #3f5e45;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .workflow-callout strong span {
    display: block;
    margin-bottom: 3px;
    color: #8cab90;
    font-family: var(--serif);
    font-size: 0.82rem;
    font-weight: 400;
  }

  .workflow-callout small {
    margin-top: 7px;
    color: #7b847d;
    font-size: 0.62rem;
    line-height: 1.35;
  }

  .workflow-callout::after {
    position: absolute;
    top: 31px;
    width: clamp(52px, 6vw, 82px);
    height: 1px;
    background: #80a486;
    content: "";
  }

  .workflow-callout::before {
    position: absolute;
    top: 28px;
    width: 7px;
    height: 7px;
    background: #80a486;
    border-radius: 50%;
    content: "";
  }

  .workflow-step-1 .workflow-callout {
    left: -44px;
    text-align: right;
  }

  .workflow-step-1 .workflow-callout {
    top: 25%;
  }

  .workflow-step-3 .workflow-callout {
    top: 56%;
  }

  .workflow-step-1 .workflow-callout::after {
    left: calc(100% + 10px);
  }

  .workflow-step-1 .workflow-callout::before {
    left: calc(100% + 10px + clamp(49px, 6vw, 79px));
  }

  .workflow-step-2 .workflow-callout,
  .workflow-step-3 .workflow-callout {
    right: -44px;
    text-align: left;
  }

  .workflow-step-2 .workflow-callout {
    top: 16%;
  }

  .workflow-step-2 .workflow-callout::after,
  .workflow-step-3 .workflow-callout::after {
    right: calc(100% + 10px);
  }

  .workflow-step-2 .workflow-callout::before,
  .workflow-step-3 .workflow-callout::before {
    right: calc(100% + 10px + clamp(49px, 6vw, 79px));
  }

  .workflow-collection-callout {
    position: absolute;
    bottom: 12%;
    left: -44px;
    width: min(112px, 30%);
    margin: 0;
    color: #527158;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: right;
  }

  .workflow-collection-callout::before {
    position: absolute;
    top: 10px;
    left: calc(100% + 10px);
    width: clamp(52px, 6vw, 82px);
    height: 1px;
    background: #80a486;
    content: "";
  }

  .workflow-collection-callout::after {
    position: absolute;
    top: 7px;
    left: calc(100% + 10px + clamp(49px, 6vw, 79px));
    width: 7px;
    height: 7px;
    background: #80a486;
    border-radius: 50%;
    content: "";
  }

  .product-section {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(480px, 1.18fr);
    gap: clamp(48px, 7vw, 100px);
    align-items: center;
    min-height: 766px;
    padding-block: 78px;
    border-top: 1px solid var(--line);
  }

  .section-heading {
    display: block;
    margin: 0;
  }

  .section-heading .eyebrow {
    margin-bottom: 22px;
  }

  .section-heading h2 {
    font-size: clamp(2.65rem, 4.3vw, 4.6rem);
    line-height: 1;
  }

  .section-heading > p:last-child {
    max-width: 480px;
    margin: 24px 0 0;
    color: var(--ink-muted);
    font-size: clamp(0.96rem, 1.25vw, 1.08rem);
    line-height: 1.55;
  }

  .plant-field-window {
    position: relative;
    width: 100%;
    height: 555px;
    align-self: center;
    justify-self: center;
    overflow: hidden;
    background: radial-gradient(circle at center, rgba(67, 91, 71, 0.08), transparent 68%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 28%, rgba(0, 0, 0, 0.88) 48%, rgba(0, 0, 0, 0.4) 72%, transparent 100%);
    mask-image: radial-gradient(ellipse at center, #000 28%, rgba(0, 0, 0, 0.88) 48%, rgba(0, 0, 0, 0.4) 72%, transparent 100%);
  }

  .plant-field {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(7, 1fr);
    gap: 8px 10px;
    width: 126%;
    height: 124%;
    padding: 12px;
    transform: translate(-50%, -50%);
  }

  .collection-plant {
    position: relative;
    display: block;
    width: 56px;
    height: 58px;
    place-self: center;
  }

  .collection-plant img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 5px 7px rgba(0, 0, 0, 0.16));
  }

  .logo-plant,
  .logo-plant svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .logo-plant svg {
    filter: drop-shadow(0 5px 7px rgba(0, 0, 0, 0.12));
  }

  .collection-plant small {
    position: absolute;
    top: 60px;
    left: 50%;
    width: 86px;
    color: #8f9991;
    font-size: 0.56rem;
    font-weight: 500;
    line-height: 1.15;
    text-align: center;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .closing {
    display: grid;
    justify-items: center;
    padding-block: 134px 142px;
    text-align: center;
  }

  .closing-mark {
    display: grid;
    place-items: center;
    width: 116px;
    height: 116px;
    margin-bottom: 40px;
    color: #5c785d;
    background: rgba(194, 207, 184, 0.1);
    border: 1px solid rgba(194, 207, 184, 0.17);
    border-radius: 50%;
  }

  .centered {
    margin-bottom: 26px;
  }

  .closing h2 {
    max-width: 880px;
  }

  .closing > p:not(.eyebrow) {
    margin: 28px 0 30px;
    color: var(--ink-muted);
  }

  .launch-badge-light {
    min-width: 230px;
    align-items: center;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: 104px;
    border-top: 1px solid var(--line);
    color: #7f8881;
    font-size: 0.76rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer p:last-child {
    text-align: right;
  }

  .footer-brand {
    color: #bec5bd;
    font-size: 0.88rem;
  }

  .footer-links {
    display: flex;
    gap: 22px;
  }

  .footer-links a {
    color: var(--ink-muted);
    text-underline-offset: 5px;
  }

  .reveal {
    animation: reveal 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero-visual.reveal {
    animation-delay: 100ms;
  }

  @keyframes reveal {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 58px;
    }

    .hero-copy {
      max-width: 720px;
    }

    .hero-visual {
      min-height: 590px;
    }

    .phone-shot {
      width: 285px;
    }

