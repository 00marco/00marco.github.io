---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlantMark from "../components/PlantMark.astro";

const title = "LivingNotes — A place for thoughts to grow";
const description = "A calm, visual space for notes, ideas, and the thinking that happens between them. Coming soon for iPhone and iPad.";

const benefits = [
  {
    number: "01",
    title: "See the shape of your thinking",
    copy: "Give each subject its own place, then return to the whole landscape whenever you need perspective.",
  },
  {
    number: "02",
    title: "Write without the noise",
    copy: "A clear page keeps attention on the thought in front of you—not on managing a complicated system.",
  },
  {
    number: "03",
    title: "Let ideas develop naturally",
    copy: "Collect passing thoughts, working notes, and longer reflections without deciding too much up front.",
  },
];
---

<BaseLayout {title} {description}>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="LivingNotes home">
      <span class="brand-mark"><PlantMark size={32} /></span>
      <span>LivingNotes</span>
    </a>
    <a class="header-link" href="#inside">Inside the app</a>
  </header>

  <main id="top">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span> Notes for independent thought</p>
        <h1 id="hero-title">Give your thoughts<br /><em>room to grow.</em></h1>
        <p class="lede">LivingNotes is a calm, visual place to gather ideas, follow them further, and find your way back to what matters.</p>
        <div class="hero-actions">
          <p class="launch-badge"><small>In development</small>Coming soon</p>
          <span class="platform-note">For iPhone and iPad</span>
        </div>
      </div>

      <div class="hero-visual reveal" aria-label="LivingNotes shown on iPhone">
        <div class="halo halo-one"></div>
        <div class="halo halo-two"></div>
        <div class="sprout-card" aria-hidden="true">
          <PlantMark size={54} />
          <span>One thought at a time</span>
        </div>
        <figure class="phone-shot">
          <img src="/images/livingnotes-iphone.jpg" alt="LivingNotes on iPhone showing a visual garden of note collections" width="768" height="1665" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="product-section shell" id="inside" aria-labelledby="inside-title">
      <div class="section-heading">
        <p class="eyebrow"><span></span> A different view of your notes</p>
        <h2 id="inside-title">Your ideas, arranged<br />like a living collection.</h2>
        <p>Move between the wider view and the page in front of you. LivingNotes keeps both close at hand.</p>
      </div>

      <div class="device-stage">
        <div class="stage-glow" aria-hidden="true"></div>
        <figure class="tablet-shot">
          <img src="/images/livingnotes-ipad.jpg" alt="LivingNotes on iPad showing named collections represented as plants" width="1600" height="1112" loading="lazy" />
        </figure>
        <figure class="note-shot">
          <img src="/images/livingnotes-note.jpg" alt="A focused note open in LivingNotes on iPhone" width="640" height="1387" loading="lazy" />
        </figure>
      </div>
    </section>

    <section class="benefits shell" aria-label="Benefits">
      {benefits.map((benefit) => (
        <article class="benefit">
          <span class="benefit-number">{benefit.number}</span>
          <PlantMark size={42} />
          <h3>{benefit.title}</h3>
          <p>{benefit.copy}</p>
        </article>
      ))}
    </section>

    <section class="closing shell" aria-labelledby="closing-title">
      <div class="closing-mark" aria-hidden="true"><PlantMark size={82} /></div>
      <p class="eyebrow centered"><span></span> Begin with a thought <span></span></p>
      <h2 id="closing-title">Make a little space<br />for what’s on your mind.</h2>
      <p>LivingNotes is coming soon for iPhone and iPad.</p>
      <p class="launch-badge launch-badge-light"><small>In development</small>Coming soon</p>
    </section>
  </main>

  <footer class="site-footer shell">
    <a class="brand footer-brand" href="#top"><PlantMark size={27} /><span>LivingNotes</span></a>
    <nav class="footer-links" aria-label="Support and legal">
      <a href="/support/">Support</a>
      <a href="/terms/">Terms</a>
    </nav>
    <p>© {new Date().getFullYear()} LivingNotes</p>
  </footer>
</BaseLayout>

<style>
  .shell {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 92px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: #485d49;
    background: #d9dfce;
    border-radius: 50%;
  }

  .header-link {
    color: var(--ink-muted);
    font-size: 0.9rem;
    text-underline-offset: 5px;
    transition: color 160ms ease;
  }

  .header-link:hover {
    color: var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
    min-height: 760px;
    padding-block: 72px 94px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    color: var(--sage-light);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .eyebrow > span {
    display: block;
    width: 26px;
    height: 1px;
    background: currentColor;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.99;
  }

  h1 {
    max-width: 720px;
    font-size: clamp(4.2rem, 7vw, 7.3rem);
  }

  h1 em {
    color: var(--sage-light);
    font-weight: 400;
  }

  .lede {
    max-width: 540px;
    margin: 34px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 38px;
  }

  .launch-badge {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 62px;
    padding: 11px 20px;
    color: #18221c;
    background: var(--ink);
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    gap: 3px;
    margin: 0;
  }

  .launch-badge small {
    color: #58625b;
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .platform-note {
    color: #8f9790;
    font-size: 0.78rem;
  }

  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 640px;
  }

  .halo {
    position: absolute;
    border: 1px solid rgba(168, 190, 158, 0.13);
    border-radius: 50%;
  }

  .halo-one {
    width: 610px;
    height: 610px;
  }

  .halo-two {
    width: 470px;
    height: 470px;
  }

  .phone-shot {
    position: relative;
    z-index: 2;
    width: min(330px, 67%);
    margin: 0;
    padding: 9px;
    background: #111513;
    border: 1px solid rgba(236, 239, 230, 0.25);
    border-radius: 44px;
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    transform: rotate(2.5deg);
  }

  .phone-shot img {
    border-radius: 35px;
  }

  .sprout-card {
    position: absolute;
    z-index: 3;
    right: 4%;
    bottom: 13%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 16px 13px 11px;
    color: #243029;
    background: #d8dfce;
    border-radius: 18px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
    font-family: var(--serif);
    font-size: 1rem;
  }

  .product-section {
    padding-block: 112px 118px;
    border-top: 1px solid var(--line);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr 0.55fr;
    column-gap: 40px;
    align-items: end;
    margin-bottom: 64px;
  }

  .section-heading .eyebrow {
    grid-column: 1 / -1;
  }

  h2 {
    font-size: clamp(3rem, 5.4vw, 5.5rem);
  }

  .section-heading > p:last-child {
    max-width: 400px;
    margin: 0 0 7px auto;
    color: var(--ink-muted);
    line-height: 1.7;
  }

  .device-stage {
    position: relative;
    min-height: 585px;
    padding: 7% 10% 0;
    background: linear-gradient(140deg, rgba(58, 78, 66, 0.7), rgba(35, 45, 40, 0.45));
    border: 1px solid var(--line);
    border-radius: 38px;
    overflow: hidden;
  }

  .device-stage::before {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(201, 215, 196, 0.11) 1px, transparent 1px);
    background-size: 22px 22px;
    content: "";
    mask-image: linear-gradient(to bottom, black, transparent 75%);
  }

  .stage-glow {
    position: absolute;
    top: -35%;
    right: 5%;
    width: 500px;
    height: 500px;
    background: rgba(123, 158, 116, 0.2);
    border-radius: 50%;
    filter: blur(80px);
  }

  .tablet-shot {
    position: relative;
    z-index: 1;
    width: min(830px, 78%);
    margin: 0;
    padding: 9px;
    background: #171b19;
    border: 1px solid rgba(236, 239, 230, 0.21);
    border-radius: 26px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.38);
    transform: rotate(-1.5deg);
  }

  .tablet-shot img {
    border-radius: 18px;
  }

  .note-shot {
    position: absolute;
    z-index: 2;
    right: 8%;
    bottom: -14%;
    width: 205px;
    margin: 0;
    padding: 7px;
    background: #121614;
    border: 1px solid rgba(236, 239, 230, 0.2);
    border-radius: 30px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
    transform: rotate(3.5deg);
  }

  .note-shot img {
    border-radius: 23px;
  }

  .benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .benefit {
    position: relative;
    padding: 64px 42px 70px;
  }

  .benefit + .benefit {
    border-left: 1px solid var(--line);
  }

  .benefit-number {
    position: absolute;
    top: 25px;
    right: 28px;
    color: #67716a;
    font-family: var(--serif);
    font-size: 0.9rem;
  }

  .benefit :global(.plant-mark) {
    margin-bottom: 32px;
    color: #5c785d;
  }

  .benefit h3 {
    max-width: 280px;
    margin: 0 0 17px;
    font-family: var(--serif);
    font-size: clamp(1.55rem, 2.2vw, 2.2rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .benefit p {
    max-width: 300px;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.91rem;
    line-height: 1.7;
  }

  .closing {
    display: grid;
    justify-items: center;
    padding-block: 134px 142px;
    text-align: center;
  }

  .closing-mark {
    display: grid;
    place-items: center;
    width: 116px;
    height: 116px;
    margin-bottom: 40px;
    color: #5c785d;
    background: rgba(194, 207, 184, 0.1);
    border: 1px solid rgba(194, 207, 184, 0.17);
    border-radius: 50%;
  }

  .centered {
    margin-bottom: 26px;
  }

  .closing h2 {
    max-width: 880px;
  }

  .closing > p:not(.eyebrow) {
    margin: 28px 0 30px;
    color: var(--ink-muted);
  }

  .launch-badge-light {
    min-width: 230px;
    align-items: center;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: 104px;
    border-top: 1px solid var(--line);
    color: #7f8881;
    font-size: 0.76rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer p:last-child {
    text-align: right;
  }

  .footer-brand {
    color: #bec5bd;
    font-size: 0.88rem;
  }

  .footer-links {
    display: flex;
    gap: 22px;
  }

  .footer-links a {
    color: var(--ink-muted);
    text-underline-offset: 5px;
  }

  .reveal {
    animation: reveal 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero-visual.reveal {
    animation-delay: 100ms;
  }

  @keyframes reveal {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 76px;
    }

    .hero-copy {
      max-width: 720px;
    }

    .hero-visual {
      min-height: 680px;
    }

    .phone-shot {
      width: 320px;
    }

    .sprout-card {
      right: 17%;
    }

    .section-heading {
      grid-template-columns: 1fr;
    }

    .section-heading > p:last-child {
      margin: 26px 0 0;
    }

    .device-stage {
      min-height: 480px;
      padding-inline: 5%;
    }

    .tablet-shot {
      width: 85%;
    }

    .benefit {
      padding-inline: 24px;
    }
  }

  @media (max-width: 680px) {
    .shell {
      width: min(100% - 30px, 540px);
    }

    .site-header {
      min-height: 76px;
    }

    .header-link {
      display: none;
    }

    .hero {
      min-height: auto;
      padding-block: 66px 76px;
    }

    h1 {
      font-size: clamp(3.5rem, 17vw, 5rem);
    }

    .lede {
      font-size: 1rem;
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero-visual {
      min-height: 570px;
      margin-top: 14px;
      overflow: hidden;
    }

    .halo-one {
      width: 510px;
      height: 510px;
    }

    .halo-two {
      width: 390px;
      height: 390px;
    }

    .phone-shot {
      width: 272px;
    }

    .sprout-card {
      right: 1%;
      bottom: 8%;
      font-size: 0.9rem;
    }

    .product-section {
      padding-block: 90px 100px;
    }

    h2 {
      font-size: clamp(2.75rem, 13vw, 4rem);
    }

    .section-heading {
      margin-bottom: 44px;
    }

    .device-stage {
      min-height: 360px;
      padding: 10% 3% 0;
      border-radius: 24px;
    }

    .tablet-shot {
      width: 94%;
      padding: 5px;
      border-radius: 15px;
    }

    .tablet-shot img {
      border-radius: 10px;
    }

    .note-shot {
      right: 2%;
      bottom: -10%;
      width: 118px;
      padding: 4px;
      border-radius: 19px;
    }

    .note-shot img {
      border-radius: 15px;
    }

    .benefits {
      grid-template-columns: 1fr;
    }

    .benefit {
      padding: 56px 20px 58px;
    }

    .benefit + .benefit {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .benefit h3,
    .benefit p {
      max-width: 420px;
    }

    .closing {
      padding-block: 104px 112px;
    }

    .site-footer {
      grid-template-columns: 1fr auto;
    }

    .footer-links {
      gap: 14px;
    }
  }
</style>
