---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlantMark from "../components/PlantMark.astro";
import { SITE_ASSETS } from "../config";

const title = "LivingNotes — Give unfinished ideas time to grow";
const description = "A calm place to set thoughts aside, let them develop, and return before they fade. Coming soon for iPhone and iPad.";

const collectionNames = [
  "Songs", "Research ideas", "Joke ideas", "Movies", "Books", "Scripts",
  "Lecture notes", "Journal", "Recipes", "Home projects", "To-do", "Poems",
  "Story seeds", "Characters", "Experiments", "Questions", "Quotes", "Sketches",
  "Essays", "Articles", "Podcast ideas", "Game ideas", "Designs", "Trips",
  "Gift ideas", "Reading list", "Watchlist", "Classes", "Work notes", "Dreams",
  "Memories", "Garden", "Repairs", "Finances", "Health", "Habits",
  "Goals", "Events", "Letters", "Photos", "Inventions", "Side projects",
  "Song fragments", "Thesis ideas", "Interview notes", "Worldbuilding", "Riffs", "Observations",
  "Problem list", "Learning notes", "Meal ideas", "Weekend plans", "Prototypes", "Writing prompts",
  "People", "Someday",
];

const plantCombinations = [0, 2, 3, 4, 5].flatMap((foliage) =>
  Array.from({ length: 5 }, (_, pot) => ({ foliage, pot })),
);

// Shuffle complete decks so every allowed design gets used before it repeats.
const shuffledPlantDeck = (seed: number) => {
  const deck = [...plantCombinations];
  let state = seed >>> 0;

  for (let index = deck.length - 1; index > 0; index -= 1) {
    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
    const swapIndex = state % (index + 1);
    [deck[index], deck[swapIndex]] = [deck[swapIndex], deck[index]];
  }

  return deck;
};

const collectionPlants = [
  ...shuffledPlantDeck(0x4c697669),
  ...shuffledPlantDeck(0x6e674e6f),
  ...shuffledPlantDeck(0x74657347),
]
  .slice(0, collectionNames.length)
  .map(({ foliage, pot }) => `/images/plants/plant_foliage-${foliage}_pot-${pot}_healthy.png`);

// A few fading plants hint at the decay mechanic without overwhelming the garden.
const decayingPlants = new Map([
  [5, 10],
  [16, 25],
  [29, 50],
  [35, 100],
  [50, 25],
]);

decayingPlants.forEach((decay, index) => {
  collectionPlants[index] = `/images/plants/plant_foliage-5_pot-4_decay-${decay}.png`;
});

const yellowingPlants = new Map([
  [8, "/images/plants/plant_foliage-2_pot-0_decay-25.png"],
  [14, "/images/plants/plant_foliage-3_pot-2_decay-25.png"],
  [20, "/images/plants/plant_foliage-4_pot-1_decay-25.png"],
  [27, "/images/plants/plant_foliage-5_pot-3_decay-25.png"],
  [32, "/images/plants/plant_foliage-3_pot-4_decay-50.png"],
  [33, "/images/plants/plant_foliage-4_pot-0_decay-50.png"],
  [44, "/images/plants/plant_foliage-2_pot-0_decay-25.png"],
  [52, "/images/plants/plant_foliage-4_pot-1_decay-25.png"],
]);

yellowingPlants.forEach((plant, index) => {
  collectionPlants[index] = plant;
});

const logoPlantPots = new Map([
  [2, 1],
  [12, 2],
  [23, 3],
  [34, 4],
  [47, 0],
  [54, 2],
]);

const plantFieldNames = Array.from(
  { length: 120 },
  (_, index) => collectionNames[index % collectionNames.length],
);

const decaySteps = [
  {
    title: "Notice the yellow",
    description: "A yellowing plant means its notes need attention.",
    image: SITE_ASSETS.decayWorkflow[0],
  },
  {
    title: "Hold to clear",
    description: "Press and hold the caterpillar to reveal the vowel.",
    note: "Your text is only hidden—it is never deleted or damaged.",
    image: SITE_ASSETS.decayWorkflow[1],
  },
  {
    title: "Clean again",
    description: "One vowel on each decaying card is covered every day.",
    image: SITE_ASSETS.decayWorkflow[2],
  },
];

---

<BaseLayout {title} {description}>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="LivingNotes home">
      <span class="brand-mark"><PlantMark size={32} /></span>
      <span>LivingNotes</span>
    </a>
    <a class="header-link" href="#inside">Inside the app</a>
  </header>

  <main id="top">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span> A place for thoughts to wait</p>
        <h1 id="hero-title">Some ideas need<br /><em>time to take root.</em></h1>
        <p class="lede">LivingNotes is a parking lot for unfinished thoughts—a place to keep songs, stories, research questions, and experiments without forcing them to be finished before they’re ready.</p>
        <div class="hero-actions">
          <p class="launch-badge"><small>In development</small>Coming soon</p>
        </div>
      </div>

      <div class="hero-visual reveal">
        <div class="halo halo-one"></div>
        <div class="halo halo-two"></div>
        <div class="hero-carousel" data-hero-carousel aria-roledescription="carousel" aria-label="LivingNotes across devices">
          <div class="hero-carousel-viewport">
            <figure class="hero-slide hero-phone-shot is-active" data-hero-slide aria-label="1 of 3: iPhone" aria-hidden="false">
              <img src={SITE_ASSETS.heroPhone.src} alt={SITE_ASSETS.heroPhone.alt} width={SITE_ASSETS.heroPhone.width} height={SITE_ASSETS.heroPhone.height} fetchpriority="high" />
            </figure>
            <figure class="hero-slide hero-ipad-shot" data-hero-slide aria-label="2 of 3: iPad" aria-hidden="true">
              <img src={SITE_ASSETS.heroTablet.src} alt={SITE_ASSETS.heroTablet.alt} width={SITE_ASSETS.heroTablet.width} height={SITE_ASSETS.heroTablet.height} fetchpriority="high" />
            </figure>
            <figure class="hero-slide hero-mac-shot" data-hero-slide aria-label="3 of 3: Mac" aria-hidden="true">
              <div class="macbook-screen">
                <img src={SITE_ASSETS.heroMac.src} alt={SITE_ASSETS.heroMac.alt} width={SITE_ASSETS.heroMac.width} height={SITE_ASSETS.heroMac.height} fetchpriority="high" />
              </div>
              <span class="macbook-base" aria-hidden="true"></span>
            </figure>
          </div>
          <div class="hero-carousel-controls" aria-label="Choose a device">
            <button type="button" class="hero-carousel-dot is-active" data-hero-dot aria-label="Show LivingNotes on iPhone" aria-current="true"><span>iPhone</span></button>
            <button type="button" class="hero-carousel-dot" data-hero-dot aria-label="Show LivingNotes on iPad"><span>iPad</span></button>
            <button type="button" class="hero-carousel-dot" data-hero-dot aria-label="Show LivingNotes on Mac"><span>Mac</span></button>
          </div>
        </div>
      </div>
    </section>

    <section class="incubation" aria-labelledby="incubation-title">
      <div class="shell incubation-inner">
        <div class="incubation-copy">
          <h2 id="incubation-title">How does it work?</h2>
          <p class="incubation-intro">Old notes can be hard to return to once the spark has faded. LivingNotes gives you a gentler way back: find the caterpillar, hold it for two seconds, and reveal the thought underneath.</p>
        </div>

        <div class="feature-decay" aria-label="Decay workflow">
          <ol class="workflow-steps">
            {decaySteps.map((step, index) => (
              <li class={`workflow-step workflow-step-${index + 1}`}>
                <figure class="workflow-shot">
                  {index === 1 ? (
                    <div class="hold-animation">
                      <img class="hold-phone" src={step.image.src} alt={step.image.alt} width={step.image.width} height={step.image.height} loading="lazy" />
                      <img class="hold-repaired" src={SITE_ASSETS.decayWorkflow[2].src} alt="" width={SITE_ASSETS.decayWorkflow[2].width} height={SITE_ASSETS.decayWorkflow[2].height} loading="lazy" aria-hidden="true" />
                      <img class="hold-hand" src="/images/pointing-hand.png" alt="" width="512" height="512" loading="lazy" aria-hidden="true" />
                    </div>
                  ) : (
                    <img src={step.image.src} alt={step.image.alt} width={step.image.width} height={step.image.height} loading="lazy" />
                  )}
                  <p class="workflow-step-label">Step {index + 1}</p>
                  <figcaption class="workflow-callout">
                    <strong>{step.title}</strong>
                    <span>{step.description}</span>
                    {step.note && <small>{step.note}</small>}
                  </figcaption>
                  {index === 1 && <p class="workflow-collection-callout">Each plant is a collection of notes.</p>}
                </figure>
              </li>
            ))}
          </ol>
          <p class="decay-outro">Notice what needs attention, clear one caterpillar, then read the note whole again. This small repair loop gives an old thought a gentle way back into view.</p>
        </div>

        <article class="feature-chapter feature-cards" aria-labelledby="feature-cards-title">
          <div class="feature-copy">
            <p class="feature-number">02</p>
            <h3 id="feature-cards-title">Small cards,<br />larger structures.</h3>
            <div class="feature-prose">
              <p>A thread can hold as many cards as the idea needs, but every card stops at 200 characters. The limit encourages one short, standalone thought at a time.</p>
              <p>Swipe through the rail, then move cards into the order that makes sense. It is closer to building an outline than filling one endless document.</p>
            </div>
          </div>

          <figure class="feature-device feature-ipad">
            <img src={SITE_ASSETS.featureCards.src} alt={SITE_ASSETS.featureCards.alt} width={SITE_ASSETS.featureCards.width} height={SITE_ASSETS.featureCards.height} loading="lazy" />
          </figure>
        </article>

        <article class="feature-chapter feature-garden" aria-labelledby="feature-garden-title">
          <figure class="feature-device feature-mac">
            <div class="macbook-screen">
              <img src={SITE_ASSETS.featureGarden.src} alt={SITE_ASSETS.featureGarden.alt} width={SITE_ASSETS.featureGarden.width} height={SITE_ASSETS.featureGarden.height} loading="lazy" />
            </div>
            <span class="macbook-base" aria-hidden="true"></span>
          </figure>

          <div class="feature-copy">
            <p class="feature-number">03</p>
            <h3 id="feature-garden-title">A garden,<br />not another feed.</h3>
            <div class="feature-prose">
              <p>Each garden section gives you 20 places for plants. Put them in any open slot, then move or swap them as your priorities change.</p>
              <p>Like gardening in an apartment, the visible space is intentionally finite. You choose what deserves a place without limiting your whole life to one plot—new sections make room for other areas.</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="product-section shell" id="inside" aria-labelledby="inside-title">
      <div class="section-heading">
        <p class="eyebrow"><span></span> The card is the container</p>
        <h2 id="inside-title">Unfinished thoughts,<br />given a shape.</h2>
        <p>Cards keep ideas distinct without isolating them. Add what you know, leave room for what you don’t, and see the whole collection at once.</p>
      </div>

      <div class="plant-field-window" role="img" aria-label="An expansive grid of LivingNotes plants continuing beyond the visible area">
        <div class="plant-field" aria-hidden="true">
          {plantFieldNames.map((name, index) => (
            <span class="collection-plant">
            {logoPlantPots.has(index) ? (
              <span class="logo-plant">
                <svg viewBox="0 0 624 648" fill="none">
                  <g transform="translate(139 218) scale(7.2)">
                    <path d="M24 35V18" stroke="#76513d" stroke-width="2.5" stroke-linecap="round" />
                    <path d="M24 26C17 26 12.5 22.3 12.5 16.2C19.3 15.4 23.8 18.8 24 26Z" fill="#76956f" />
                    <path d="M24 21.5C24.4 14.4 28.7 10.3 35.7 10.5C35.8 17 31.7 21.2 24 21.5Z" fill="#9ab08b" />
                    <path d="M24 18.5C21.1 15.9 21.3 12.5 23.4 9.2C26.8 11.4 27.7 14.8 24 18.5Z" fill="#b7c7a8" transform="rotate(-30 24 18.5)" />
                  </g>
                </svg>
                <img
                  src={`/images/plants/plant_foliage-0_pot-${logoPlantPots.get(index)}_healthy.png`}
                  alt=""
                  width="624"
                  height="648"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : (
              <img src={collectionPlants[index % collectionPlants.length]} alt="" width="624" height="648" loading="lazy" decoding="async" />
            )}
            <small>{name}</small>
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="closing shell" aria-labelledby="closing-title">
      <div class="closing-mark" aria-hidden="true"><PlantMark size={82} /></div>
      <p class="eyebrow centered"><span></span> Begin with a thought <span></span></p>
      <h2 id="closing-title">Not every thought needs<br />an answer today.</h2>
      <p>LivingNotes is coming soon for iPhone and iPad.</p>
      <p class="launch-badge launch-badge-light"><small>In development</small>Coming soon</p>
    </section>
  </main>

  <footer class="site-footer shell">
    <a class="brand footer-brand" href="#top"><PlantMark size={27} /><span>LivingNotes</span></a>
    <nav class="footer-links" aria-label="Support and legal">
      <a href="/support/">Support</a>
      <a href="/terms/">Terms</a>
    </nav>
    <p>© {new Date().getFullYear()} LivingNotes</p>
  </footer>
</BaseLayout>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-hero-carousel]");

  carousels.forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-hero-slide]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-hero-dot]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeIndex = 0;
    let timer: number | undefined;
    let automaticAdvances = 0;

    const showSlide = (nextIndex: number) => {
      activeIndex = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });

      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        dot.classList.toggle("is-active", isActive);
        if (isActive) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    const stop = () => {
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (reduceMotion.matches) return;

      const delay = automaticAdvances < slides.length ? 1000 : 3000;
      timer = window.setTimeout(() => {
        showSlide(activeIndex + 1);
        automaticAdvances += 1;
        start();
      }, delay);
    };

    dots.forEach((dot, index) => dot.addEventListener("click", () => {
      showSlide(index);
    }));

    carousel.addEventListener("focusin", stop);
    carousel.addEventListener("focusout", (event) => {
      if (!carousel.contains(event.relatedTarget as Node | null)) start();
    });
    reduceMotion.addEventListener("change", start);
    document.addEventListener("visibilitychange", () => document.hidden ? stop() : start());
    start();
  });
</script>

<style>
  .shell {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 92px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: #485d49;
    background: #d9dfce;
    border-radius: 50%;
  }

  .header-link {
    color: var(--ink-muted);
    font-size: 0.9rem;
    text-underline-offset: 5px;
    transition: color 160ms ease;
  }

  .header-link:hover {
    color: var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(480px, 1.12fr);
    gap: clamp(30px, 4vw, 72px);
    align-items: center;
    min-height: 700px;
    padding-block: 54px 72px;
  }

  .hero-copy {
    max-width: 560px;
    text-align: left;
  }

  .hero-copy .eyebrow,
  .hero-actions {
    justify-content: flex-start;
  }

  .hero-copy h1,
  .hero-copy .lede {
    margin-left: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    color: var(--sage-light);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .eyebrow > span {
    display: block;
    width: 26px;
    height: 1px;
    background: currentColor;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.99;
  }

  h1 {
    max-width: 620px;
    font-size: clamp(3.2rem, 5vw, 5.15rem);
  }

  h1 em {
    color: var(--sage-light);
    font-weight: 400;
  }

  .lede {
    max-width: 540px;
    margin: 34px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 38px;
  }

  .launch-badge {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 62px;
    padding: 11px 20px;
    color: #18221c;
    background: var(--ink);
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    gap: 3px;
    margin: 0;
  }

  .launch-badge small {
    color: #58625b;
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 560px;
  }

  .hero-carousel {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-carousel-viewport {
    position: relative;
    height: 510px;
  }

  .hero-slide {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transform: translate(-43%, -50%) rotate(var(--hero-device-tilt, 0deg));
    transition: opacity 650ms ease, transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, -50%) rotate(var(--hero-device-tilt, 0deg));
  }

  .hero-slide img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .hero-mac-shot {
    width: min(96%, 620px);
  }

  .hero-mac-shot,
  .feature-mac {
    padding: 8px 8px 14px;
    background: linear-gradient(145deg, #383d3b, #121514 58%);
    border: 1px solid rgba(232, 237, 232, 0.28);
    border-radius: 15px 15px 10px 10px;
    box-shadow: inset 0 0 0 2px #090b0a;
  }

  .hero-mac-shot::before,
  .feature-mac::before {
    position: absolute;
    top: 4px;
    left: 50%;
    width: 5px;
    height: 5px;
    background: #050606;
    border-radius: 50%;
    content: "";
    transform: translateX(-50%);
  }

  .macbook-screen {
    position: relative;
    z-index: 1;
    aspect-ratio: 1.265 / 1;
    overflow: hidden;
    background: #050606;
    border-radius: 8px 8px 4px 4px;
  }

  .hero-mac-shot .macbook-screen img,
  .feature-mac .macbook-screen img {
    width: 110%;
    max-width: none;
    height: auto;
    transform: translate(-4.6%, -4.1%);
  }

  .macbook-base {
    position: absolute;
    z-index: 0;
    right: -6%;
    bottom: -4%;
    left: -6%;
    height: 5%;
    min-height: 7px;
    background: linear-gradient(180deg, #777d79, #303532 48%, #171a18);
    border-radius: 2px 2px 45% 45%;
    box-shadow: 0 7px 12px rgba(0, 0, 0, 0.28);
  }

  .macbook-base::after {
    position: absolute;
    top: 0;
    left: 44%;
    width: 12%;
    height: 35%;
    background: #a0a5a1;
    border-radius: 0 0 5px 5px;
    content: "";
  }

  .hero-ipad-shot,
  .hero-phone-shot {
    overflow: hidden;
    background: #050606;
    border: solid #050606;
    box-shadow: 0 24px 45px rgba(0, 0, 0, 0.4);
  }

  .hero-ipad-shot {
    width: min(96%, 640px);
    border-width: 3px;
    border-radius: 18px;
  }

  .hero-phone-shot {
    --hero-device-tilt: -7deg;
    width: auto;
    height: min(94%, 490px);
    aspect-ratio: 1206 / 2622;
    border-width: 3px;
    border-radius: 28px;
  }

  .hero-phone-shot img {
    width: 100%;
    height: 100%;
  }

  .hero-carousel-controls {
    display: flex;
    justify-content: center;
    gap: 9px;
    margin-top: 8px;
  }

  .hero-carousel-dot {
    position: relative;
    width: 38px;
    height: 24px;
    padding: 0;
    color: transparent;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .hero-carousel-dot::before {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22px;
    height: 3px;
    background: rgba(160, 180, 164, 0.32);
    border-radius: 999px;
    content: "";
    transform: translate(-50%, -50%);
    transition: width 180ms ease, background 180ms ease;
  }

  .hero-carousel-dot:is(:hover, :focus-visible)::before {
    background: rgba(190, 207, 192, 0.7);
  }

  .hero-carousel-dot.is-active::before {
    width: 32px;
    background: var(--sage-light);
  }

  .hero-carousel-dot span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .halo {
    position: absolute;
    border: 1px solid rgba(168, 190, 158, 0.13);
    border-radius: 50%;
  }

  .halo-one {
    width: 520px;
    height: 520px;
  }

  .halo-two {
    width: 400px;
    height: 400px;
  }

  .phone-shot {
    position: relative;
    z-index: 2;
    width: min(285px, 62%);
    margin: 0;
    padding: 9px;
    background: #111513;
    border: 1px solid rgba(236, 239, 230, 0.25);
    border-radius: 44px;
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.45);
    transform: rotate(4deg);
    transform-origin: 50% 60%;
    overflow: hidden;
  }

  .phone-shot img {
    border-radius: 35px;
  }

