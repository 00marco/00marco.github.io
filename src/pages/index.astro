    color: var(--sage-light);
    font-weight: 400;
  }

  .lede {
    max-width: 540px;
    margin: 34px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 38px;
  }

  .launch-badge {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 62px;
    padding: 11px 20px;
    color: #18221c;
    background: var(--ink);
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    gap: 3px;
    margin: 0;
  }

  .launch-badge small {
    color: #58625b;
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 540px;
  }

  .halo {
    position: absolute;
    border: 1px solid rgba(168, 190, 158, 0.13);
    border-radius: 50%;
  }

  .halo-one {
    width: 520px;
    height: 520px;
  }

  .halo-two {
    width: 400px;
    height: 400px;
  }

  .phone-shot {
    position: relative;
    z-index: 2;
    width: min(285px, 62%);
    margin: 0;
    padding: 9px;
