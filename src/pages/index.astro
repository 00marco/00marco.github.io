    position: absolute;
    top: 30px;
    width: 54px;
    height: 1px;
    background: #80a486;
    content: "";
  }

  .phone-label::before {
    position: absolute;
    top: 27px;
    width: 7px;
    height: 7px;
    background: #80a486;
    border-radius: 50%;
    content: "";
  }

  .phone-label-card {
    bottom: 27%;
    left: -18px;
    text-align: right;
  }

  .phone-label-card::after {
    left: calc(100% + 10px);
  }

  .phone-label-card::before {
    left: calc(100% + 61px);
  }

  .phone-label-decay {
    top: 31%;
    right: -18px;
    text-align: left;
  }

  .phone-label-decay::after {
    right: calc(100% + 10px);
  }

  .phone-label-decay::before {
    right: calc(100% + 61px);
  }

  .decay-workflow {
    background:
      radial-gradient(circle at 50% 10%, rgba(115, 149, 112, 0.13), transparent 34rem),
      #202723;
    border-top: 1px solid rgba(235, 238, 229, 0.1);
    border-bottom: 1px solid var(--line);
  }

  .workflow-inner {
    padding-block: 104px 112px;
  }

  .workflow-heading {
    max-width: 720px;
    margin-bottom: 58px;
  }

  .workflow-heading h2 {
    max-width: 680px;
    font-size: clamp(2.65rem, 4.8vw, 4.8rem);
    line-height: 1;
  }

  .workflow-heading > p:last-child {
    margin: 22px 0 0;
    color: var(--ink-muted);
    font-size: clamp(0.96rem, 1.25vw, 1.08rem);
    line-height: 1.55;
  }

  .workflow-steps {
    --workflow-gap: clamp(18px, 2.4vw, 32px);
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--workflow-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .workflow-step {
    position: relative;
    min-width: 0;
  }

  .step-marker {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin: 0 auto 18px;
    color: #dfe7dc;
    background: #526b56;
    border: 1px solid rgba(214, 226, 210, 0.28);
    border-radius: 50%;
    font-family: var(--serif);
    font-size: 0.75rem;
  }

  .workflow-shot {
    width: 100%;
    margin: 0;
    padding: 7px;
    background: #111513;
    border: 1px solid rgba(236, 239, 230, 0.17);
    border-radius: 24px;
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.24);
    overflow: hidden;
  }

  .workflow-shot img {
    width: 100%;
    aspect-ratio: 917 / 1715;
    background: #1e2220;
    border-radius: 17px;
    object-fit: cover;
  }

  .step-copy {
    padding: 22px 4px 0;
  }

  .step-copy h3 {
    margin: 0 0 9px;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .step-copy p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .product-section {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(480px, 1.18fr);
    gap: clamp(48px, 7vw, 100px);
    align-items: center;
    min-height: 766px;
    padding-block: 78px;
    border-top: 1px solid var(--line);
  }

  .section-heading {
    display: block;
    margin: 0;
  }

  .section-heading .eyebrow {
    margin-bottom: 22px;
  }

  .section-heading h2 {
    font-size: clamp(2.65rem, 4.3vw, 4.6rem);
    line-height: 1;
  }

  .section-heading > p:last-child {
    max-width: 480px;
    margin: 24px 0 0;
    color: var(--ink-muted);
    font-size: clamp(0.96rem, 1.25vw, 1.08rem);
    line-height: 1.55;
  }

  .plant-field {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(7, 1fr);
    gap: 18px 16px;
    width: 100%;
    height: 610px;
    padding: 18px;
    overflow: hidden;
    background: radial-gradient(circle at center, rgba(67, 91, 71, 0.08), transparent 68%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 38%, rgba(0, 0, 0, 0.82) 61%, transparent 95%);
    mask-image: radial-gradient(ellipse at center, #000 38%, rgba(0, 0, 0, 0.82) 61%, transparent 95%);
  }

