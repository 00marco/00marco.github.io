  .macbook-screen {
    position: relative;
    z-index: 1;
    aspect-ratio: 1.265 / 1;
    overflow: hidden;
    background: #050606;
    border-radius: 8px 8px 4px 4px;
  }

  .hero-mac-shot .macbook-screen img,
  .feature-mac .macbook-screen img {
    width: 110%;
    max-width: none;
    height: auto;
    transform: translate(-4.6%, -4.1%);
  }

  .macbook-base {
    position: absolute;
    z-index: 0;
    right: -6%;
    bottom: -4%;
