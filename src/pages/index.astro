  }

  .phone-shot img {
    border-radius: 35px;
  }

  .incubation {
    color: #26302a;
    background:
      radial-gradient(circle at 50% 42%, rgba(155, 202, 161, 0.2), transparent 24rem),
      #f7f5ef;
  }

  .incubation-inner {
    display: grid;
    grid-template-columns: minmax(440px, 500px) minmax(0, 1fr);
    gap: clamp(38px, 5vw, 76px);
    align-items: center;
    padding-block: 78px;
  }

  .eyebrow-dark {
    justify-content: flex-start;
    color: #68816a;
  }

  .incubation h2 {
    max-width: 650px;
    color: #262a27;
    font-size: clamp(2.35rem, 4vw, 4.2rem);
    line-height: 0.98;
  }

  .incubation-intro {
    max-width: 620px;
    margin: 22px 0 0;
    color: #606761;
    font-size: clamp(0.96rem, 1.25vw, 1.08rem);
    line-height: 1.55;
  }

  .thought-examples {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 8px;
    margin: 24px 0 28px;
  }

  .thought-examples span {
    padding: 7px 11px;
    color: #526454;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(67, 91, 71, 0.14);
    border-radius: 999px;
    font-size: 0.72rem;
  }

  .phone-annotated {
    position: relative;
    width: 100%;
    min-height: 610px;
    display: grid;
    place-items: center;
  }

  .decay-phone {
    width: min(300px, 64%);
    margin: 0 auto;
    filter: drop-shadow(0 24px 28px rgba(28, 36, 30, 0.18));
  }

  .decay-phone img {
    width: 100%;
  }

  .phone-label {
    position: absolute;
    z-index: 1;
    margin: 0;
    color: #527158;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .phone-label span {
    display: block;
    margin-bottom: 4px;
    color: #8cab90;
    font-family: var(--serif);
    font-size: 0.82rem;
    font-weight: 400;
  }

