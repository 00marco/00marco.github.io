  .workflow-step-label {
    position: absolute;
    bottom: 0;
    left: 50%;
    margin: 0;
    color: #6e7d72;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .workflow-shot > img,
  .hold-animation {
    display: block;
    width: min(215px, 56%);
    aspect-ratio: 1206 / 2622;
    overflow: hidden;
    background: #050606;
    border: 6px solid #050606;
    border-radius: 32px;
    box-shadow: 0 24px 28px rgba(28, 36, 30, 0.18);
  }

  .workflow-shot > img,
  .hold-phone,
  .hold-repaired {
    object-fit: contain;
  }

  .hold-animation {
    position: relative;
    overflow: visible;
  }

  .hold-animation img {
    display: block;
  }

  .hold-phone,
  .hold-repaired {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 25px;
  }

  .hold-repaired {
    opacity: 0;
    animation: reveal-repaired 6.96s steps(1, end) infinite;
  }

  .hold-progress {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    pointer-events: none;
  }

  .hold-progress rect {
    stroke: #7eaa72;
    stroke-width: 12px;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-linecap: round;
    filter: drop-shadow(0 0 10px rgba(126, 170, 114, 0.45));
    animation: trace-repair 6.96s linear infinite;
  }

  .hold-hand {
    position: absolute;
    z-index: 2;
    top: 17%;
    left: -23.5%;
    width: 52%;
    height: auto;
    opacity: 0;
    transform-origin: 96.3% 35.2%;
    animation: press-decayed-character 6.96s ease-in-out infinite;
  }

  @keyframes press-decayed-character {
    0%, 31.3% { opacity: 0; transform: translateX(-220%) scale(1); }
    39.8% { opacity: 1; transform: translateX(0) scale(1); }
    43.7% { opacity: 1; transform: translateX(0) scale(0.926); }
    72.4% { opacity: 1; transform: translateX(0) scale(0.926); }
    76.3% { opacity: 1; transform: translateX(0) scale(1); }
    84.8%, 100% { opacity: 0; transform: translateX(-220%) scale(1); }
  }

  @keyframes reveal-repaired {
    0%, 72.4% { opacity: 0; }
    72.5%, 100% { opacity: 1; }
  }

  @keyframes trace-repair {
    0%, 43.6% { opacity: 0; stroke-dashoffset: 1; }
    43.7% { opacity: 1; stroke-dashoffset: 1; }
    72.4% { opacity: 1; stroke-dashoffset: 0; }
    72.5%, 100% { opacity: 0; stroke-dashoffset: 0; }
  }

  .workflow-callout {
    position: absolute;
    z-index: 1;
    width: min(112px, 30%);
    color: #527158;
    font-size: 0.72rem;
    line-height: 1.38;
  }

  .workflow-callout strong,
  .workflow-callout > span,
  .workflow-callout small {
    display: block;
  }

  .workflow-callout strong {
    margin-bottom: 5px;
    color: #3f5e45;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .workflow-callout small {
    margin-top: 7px;
    color: #7b847d;
    font-size: 0.62rem;
    line-height: 1.35;
  }

  .workflow-callout::after {
    display: none;
    position: absolute;
    top: 31px;
    width: clamp(52px, 6vw, 82px);
    height: 1px;
    background: #80a486;
    content: "";
  }

  .workflow-callout::before {
    display: none;
    position: absolute;
    top: 28px;
    width: 7px;
    height: 7px;
    background: #80a486;
    border-radius: 50%;
    content: "";
  }

  .workflow-step-1 .workflow-callout {
    left: -44px;
    text-align: right;
  }

  .workflow-step-1 .workflow-callout {
    top: 25%;
  }

  .workflow-step-3 .workflow-callout {
    top: 56%;
  }

  .workflow-step-1 .workflow-callout::after {
    left: calc(100% + 10px);
  }

  .workflow-step-1 .workflow-callout::before {
    left: calc(100% + 10px + clamp(49px, 6vw, 79px));
  }

  .workflow-step-2 .workflow-callout,
  .workflow-step-3 .workflow-callout {
    right: -44px;
    text-align: left;
  }

  .workflow-step-2 .workflow-callout {
    top: 16%;
  }

  .workflow-step-2 .workflow-callout::after,
  .workflow-step-3 .workflow-callout::after {
    right: calc(100% + 10px);
  }

  .workflow-step-2 .workflow-callout::before,
  .workflow-step-3 .workflow-callout::before {
    right: calc(100% + 10px + clamp(49px, 6vw, 79px));
  }

  .workflow-collection-callout {
    position: absolute;
    bottom: 12%;
    left: -44px;
    width: min(112px, 30%);
    margin: 0;
    color: #527158;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: right;
  }

  .workflow-collection-callout::before {
    display: none;
    position: absolute;
    top: 10px;
    left: calc(100% + 10px);
    width: clamp(52px, 6vw, 82px);
    height: 1px;
    background: #80a486;
    content: "";
  }

  .workflow-collection-callout::after {
    display: none;
    position: absolute;
    top: 7px;
    left: calc(100% + 10px + clamp(49px, 6vw, 79px));
    width: 7px;
    height: 7px;
    background: #80a486;
    border-radius: 50%;
    content: "";
  }

