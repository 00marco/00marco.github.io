    color: #8f9991;
    font-size: 0.56rem;
    font-weight: 500;
    line-height: 1.15;
    text-align: center;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .closing {
    display: grid;
    justify-items: center;
    padding-block: 134px 142px;
    text-align: center;
  }

  .closing-mark {
    display: grid;
    place-items: center;
    width: 116px;
    height: 116px;
    margin-bottom: 40px;
    color: #5c785d;
    background: rgba(194, 207, 184, 0.1);
    border: 1px solid rgba(194, 207, 184, 0.17);
    border-radius: 50%;
  }

  .centered {
    margin-bottom: 26px;
  }

  .closing h2 {
    max-width: 880px;
  }

  .closing > p:not(.eyebrow) {
    margin: 28px 0 30px;
    color: var(--ink-muted);
  }

