---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlantMark from "../components/PlantMark.astro";
import { SITE_ASSETS } from "../config";

const title = "LivingNotes — Give unfinished ideas time to grow";
const description = "A calm place to set thoughts aside, let them develop, and return before they fade. Coming soon for iPhone and iPad.";

const collectionNames = [
  "Songs", "Research ideas", "Joke ideas", "Movies", "Books", "Scripts",
  "Lecture notes", "Journal", "Recipes", "Home projects", "To-do", "Poems",
  "Story seeds", "Characters", "Experiments", "Questions", "Quotes", "Sketches",
  "Essays", "Articles", "Podcast ideas", "Game ideas", "Designs", "Trips",
  "Gift ideas", "Reading list", "Watchlist", "Classes", "Work notes", "Dreams",
  "Memories", "Garden", "Repairs", "Finances", "Health", "Habits",
  "Goals", "Events", "Letters", "Photos", "Inventions", "Side projects",
  "Song fragments", "Thesis ideas", "Interview notes", "Worldbuilding", "Riffs", "Observations",
  "Problem list", "Learning notes", "Meal ideas", "Weekend plans", "Prototypes", "Writing prompts",
  "People", "Someday",
];

const plantCombinations = [0, 2, 3, 4, 5].flatMap((foliage) =>
  Array.from({ length: 5 }, (_, pot) => ({ foliage, pot })),
);

// Shuffle complete decks so every allowed design gets used before it repeats.
const shuffledPlantDeck = (seed: number) => {
  const deck = [...plantCombinations];
  let state = seed >>> 0;

  for (let index = deck.length - 1; index > 0; index -= 1) {
    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
    const swapIndex = state % (index + 1);
    [deck[index], deck[swapIndex]] = [deck[swapIndex], deck[index]];
  }

  return deck;
};

const collectionPlants = [
  ...shuffledPlantDeck(0x4c697669),
  ...shuffledPlantDeck(0x6e674e6f),
  ...shuffledPlantDeck(0x74657347),
]
  .slice(0, collectionNames.length)
  .map(({ foliage, pot }) => `/images/plants/plant_foliage-${foliage}_pot-${pot}_healthy.png`);

// A few fading plants hint at the decay mechanic without overwhelming the garden.
const decayingPlants = new Map([
  [5, 10],
  [16, 25],
  [29, 50],
  [35, 100],
  [50, 25],
]);

decayingPlants.forEach((decay, index) => {
  collectionPlants[index] = `/images/plants/plant_foliage-5_pot-4_decay-${decay}.png`;
});

const yellowingPlants = new Map([
  [8, "/images/plants/plant_foliage-2_pot-0_decay-25.png"],
  [14, "/images/plants/plant_foliage-3_pot-2_decay-25.png"],
  [20, "/images/plants/plant_foliage-4_pot-1_decay-25.png"],
  [27, "/images/plants/plant_foliage-5_pot-3_decay-25.png"],
  [32, "/images/plants/plant_foliage-3_pot-4_decay-50.png"],
  [33, "/images/plants/plant_foliage-4_pot-0_decay-50.png"],
  [44, "/images/plants/plant_foliage-2_pot-0_decay-25.png"],
  [52, "/images/plants/plant_foliage-4_pot-1_decay-25.png"],
]);

yellowingPlants.forEach((plant, index) => {
  collectionPlants[index] = plant;
});

const logoPlantPots = new Map([
  [2, 1],
  [12, 2],
  [23, 3],
  [34, 4],
  [47, 0],
  [54, 2],
]);

const decaySteps = [
  {
    title: "Notice the yellow",
    description: "A yellowing plant means its notes need attention.",
    image: SITE_ASSETS.decayWorkflow[0],
  },
  {
    title: "Hold to clear",
    description: "Press and hold the caterpillar to reveal the vowel.",
    note: "Your text is only hidden—it is never deleted or damaged.",
    image: SITE_ASSETS.decayWorkflow[2],
  },
  {
    title: "Clean again",
    description: "One vowel on each decaying card is covered every day.",
    image: SITE_ASSETS.decayWorkflow[3],
  },
];

const featureGardenSlots = [
  collectionPlants[0], collectionPlants[3], null, collectionPlants[6], collectionPlants[8],
  null, collectionPlants[11], collectionPlants[14], collectionPlants[17], null,
  collectionPlants[20], collectionPlants[23], null, collectionPlants[26], collectionPlants[29],
  collectionPlants[31], null, collectionPlants[36], null, collectionPlants[41],
];
---

<BaseLayout {title} {description}>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="LivingNotes home">
      <span class="brand-mark"><PlantMark size={32} /></span>
      <span>LivingNotes</span>
    </a>
    <a class="header-link" href="#inside">Inside the app</a>
  </header>

  <main id="top">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span> A place for thoughts to wait</p>
        <h1 id="hero-title">Some ideas need<br /><em>time to take root.</em></h1>
        <p class="lede">LivingNotes is a parking lot for unfinished thoughts—a place to keep songs, stories, research questions, and experiments without forcing them to be finished before they’re ready.</p>
        <div class="hero-actions">
          <p class="launch-badge"><small>In development</small>Coming soon</p>
        </div>
      </div>

      <div class="hero-visual reveal" aria-label="LivingNotes shown on iPhone">
        <div class="halo halo-one"></div>
        <div class="halo halo-two"></div>
        <figure class="phone-shot">
          <img src={SITE_ASSETS.heroPhone.src} alt={SITE_ASSETS.heroPhone.alt} width={SITE_ASSETS.heroPhone.width} height={SITE_ASSETS.heroPhone.height} fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="incubation" aria-labelledby="incubation-title">
      <div class="shell incubation-inner">
        <div class="incubation-copy">
          <h2 id="incubation-title">How does it work?</h2>
          <p class="incubation-intro">Plants yellow when their notes need attention. Open the note and hold the caterpillar for two seconds to bring the hidden vowel back.</p>
        </div>

        <div class="feature-decay" aria-label="Decay workflow">
          <ol class="workflow-steps">
            {decaySteps.map((step, index) => (
              <li class={`workflow-step workflow-step-${index + 1}`}>
                <figure class="workflow-shot">
                  {index === 1 ? (
                    <div class="hold-animation">
                      <img class="hold-phone" src={step.image.src} alt={step.image.alt} width={step.image.width} height={step.image.height} loading="lazy" />
                      <img class="hold-repaired" src="/images/decay-step-3-repaired.png" alt="" width="917" height="1715" loading="lazy" aria-hidden="true" />
                      <img class="hold-hand" src="/images/pointing-hand.png" alt="" width="512" height="512" loading="lazy" aria-hidden="true" />
                    </div>
                  ) : (
                    <img src={step.image.src} alt={step.image.alt} width={step.image.width} height={step.image.height} loading="lazy" />
                  )}
                  <figcaption class="workflow-callout">
                    <strong><span>{String(index + 1).padStart(2, "0")}</span>{step.title}</strong>
                    <span>{step.description}</span>
                    {step.note && <small>{step.note}</small>}
                  </figcaption>
                  {index === 1 && <p class="workflow-collection-callout">Each plant is a collection of notes.</p>}
                </figure>
              </li>
            ))}
          </ol>
        </div>

        <article class="feature-chapter feature-cards" aria-labelledby="feature-cards-title">
          <div class="feature-copy">
            <p class="feature-number">02</p>
            <h3 id="feature-cards-title">Small cards,<br />larger structures.</h3>
            <div class="feature-prose">
              <p>A thread can hold as many cards as the idea needs, but every card stops at 200 characters. The limit encourages one short, standalone thought at a time.</p>
              <p>Swipe through the rail, then move cards into the order that makes sense. It is closer to building an outline than filling one endless document.</p>
            </div>
          </div>

          <div class="card-rail-visual" role="img" aria-label="A horizontal rail of short LivingNotes cards that can be reordered into a larger outline">
            <div class="card-rail-header" aria-hidden="true">
              <span>Story structure</span>
              <small>4 cards</small>
            </div>
            <div class="card-rail" aria-hidden="true">
              <article class="sample-note-card">
                <span class="card-grip">•••</span>
                <p>The visitor arrives before anyone knows why the town has stopped keeping clocks.</p>
                <footer><span>79 / 200</span><span>Card 1</span></footer>
              </article>
              <article class="sample-note-card sample-note-card-active">
                <span class="card-grip">•••</span>
                <p>Each missing hour belongs to someone who chose to forget it.</p>
                <footer><span>60 / 200</span><span>Card 2</span></footer>
              </article>
              <article class="sample-note-card">
                <span class="card-grip">•••</span>
                <p>The clockmaker remembers every hour and has been waiting for the visitor.</p>
                <footer><span>73 / 200</span><span>Card 3</span></footer>
              </article>
            </div>
            <div class="card-rail-footer" aria-hidden="true">
              <span>← swipe through cards →</span>
              <strong>200 characters maximum</strong>
              <span>↔ move to reorder</span>
            </div>
          </div>
        </article>

        <article class="feature-chapter feature-garden" aria-labelledby="feature-garden-title">
          <div class="garden-plot" role="img" aria-label="A LivingNotes garden section with exactly 20 manually placeable slots, including open spaces">
            <div class="garden-plot-header" aria-hidden="true">
              <span>Research garden</span>
              <small>14 / 20</small>
            </div>
            <div class="garden-plot-grid" aria-hidden="true">
              {featureGardenSlots.map((plant, index) => (
                <span class:list={["garden-plot-slot", { "garden-plot-slot-open": !plant }]}>
                  {plant ? <img src={plant} alt="" width="624" height="648" loading="lazy" /> : <span>+</span>}
                  <small>{index + 1}</small>
                </span>
              ))}
            </div>
            <p class="garden-plot-hint" aria-hidden="true">Hold and move a plant to place it anywhere in the plot.</p>
          </div>

          <div class="feature-copy">
            <p class="feature-number">03</p>
            <h3 id="feature-garden-title">A garden,<br />not another feed.</h3>
            <div class="feature-prose">
              <p>Each garden section gives you 20 places for plants. Put them in any open slot, then move or swap them as your priorities change.</p>
              <p>Like gardening in an apartment, the visible space is intentionally finite. You choose what deserves a place without limiting your whole life to one plot—new sections make room for other areas.</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="product-section shell" id="inside" aria-labelledby="inside-title">
      <div class="section-heading">
        <p class="eyebrow"><span></span> The card is the container</p>
        <h2 id="inside-title">Unfinished thoughts,<br />given a shape.</h2>
        <p>Cards keep ideas distinct without isolating them. Add what you know, leave room for what you don’t, and see the whole collection at once.</p>
      </div>

      <div class="plant-field-window" role="img" aria-label="An expansive grid of LivingNotes plants continuing beyond the visible area">
        <div class="plant-field" aria-hidden="true">
          {collectionNames.map((name, index) => (
            <span class="collection-plant">
            {logoPlantPots.has(index) ? (
              <span class="logo-plant">
                <svg viewBox="0 0 624 648" fill="none">
                  <g transform="translate(139 218) scale(7.2)">
                    <path d="M24 35V18" stroke="#76513d" stroke-width="2.5" stroke-linecap="round" />
                    <path d="M24 26C17 26 12.5 22.3 12.5 16.2C19.3 15.4 23.8 18.8 24 26Z" fill="#76956f" />
                    <path d="M24 21.5C24.4 14.4 28.7 10.3 35.7 10.5C35.8 17 31.7 21.2 24 21.5Z" fill="#9ab08b" />
                    <path d="M24 18.5C21.1 15.9 21.3 12.5 23.4 9.2C26.8 11.4 27.7 14.8 24 18.5Z" fill="#b7c7a8" transform="rotate(-30 24 18.5)" />
                  </g>
                </svg>
                <img
                  src={`/images/plants/plant_foliage-0_pot-${logoPlantPots.get(index)}_healthy.png`}
                  alt=""
                  width="624"
                  height="648"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : (
              <img src={collectionPlants[index]} alt="" width="624" height="648" loading="lazy" decoding="async" />
            )}
            <small>{name}</small>
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="closing shell" aria-labelledby="closing-title">
      <div class="closing-mark" aria-hidden="true"><PlantMark size={82} /></div>
      <p class="eyebrow centered"><span></span> Begin with a thought <span></span></p>
      <h2 id="closing-title">Not every thought needs<br />an answer today.</h2>
      <p>LivingNotes is coming soon for iPhone and iPad.</p>
      <p class="launch-badge launch-badge-light"><small>In development</small>Coming soon</p>
    </section>
  </main>

  <footer class="site-footer shell">
    <a class="brand footer-brand" href="#top"><PlantMark size={27} /><span>LivingNotes</span></a>
    <nav class="footer-links" aria-label="Support and legal">
      <a href="/support/">Support</a>
      <a href="/terms/">Terms</a>
    </nav>
    <p>© {new Date().getFullYear()} LivingNotes</p>
  </footer>
</BaseLayout>

<style>
  .shell {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 92px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: #485d49;
    background: #d9dfce;
    border-radius: 50%;
  }

  .header-link {
    color: var(--ink-muted);
    font-size: 0.9rem;
    text-underline-offset: 5px;
    transition: color 160ms ease;
  }

  .header-link:hover {
    color: var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
    min-height: 650px;
    padding-block: 48px 62px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    color: var(--sage-light);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .eyebrow > span {
    display: block;
    width: 26px;
    height: 1px;
    background: currentColor;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.99;
  }

  h1 {
    max-width: 720px;
    font-size: clamp(3.3rem, 5.5vw, 5.6rem);
  }

  h1 em {
    color: var(--sage-light);
    font-weight: 400;
  }

  .lede {
    max-width: 540px;
    margin: 34px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 38px;
  }

  .launch-badge {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 62px;
    padding: 11px 20px;
    color: #18221c;
    background: var(--ink);
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    gap: 3px;
    margin: 0;
  }

  .launch-badge small {
    color: #58625b;
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 540px;
  }

  .halo {
    position: absolute;
    border: 1px solid rgba(168, 190, 158, 0.13);
    border-radius: 50%;
  }

  .halo-one {
    width: 520px;
    height: 520px;
  }

  .halo-two {
    width: 400px;
    height: 400px;
  }

  .phone-shot {
    position: relative;
    z-index: 2;
    width: min(285px, 62%);
    margin: 0;
    padding: 9px;
    background: #111513;
    border: 1px solid rgba(236, 239, 230, 0.25);
    border-radius: 44px;
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.45);
    transform: rotate(4deg);
    transform-origin: 50% 60%;
    overflow: hidden;
  }

  .phone-shot img {
    border-radius: 35px;
  }

  .incubation {
    color: #26302a;
    background:
      radial-gradient(circle at 50% 42%, rgba(155, 202, 161, 0.2), transparent 24rem),
      #f7f5ef;
  }

  .incubation-inner {
    padding-block: 68px 0;
  }

  .incubation-copy {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }

  .incubation h2 {
    max-width: 720px;
    margin-inline: auto;
    color: #262a27;
    font-size: clamp(2.35rem, 4vw, 4.2rem);
    line-height: 0.98;
  }

  .incubation-intro {
    max-width: 620px;
    margin: 22px auto 0;
    color: #606761;
    font-size: clamp(0.96rem, 1.25vw, 1.08rem);
    line-height: 1.55;
  }

  .feature-chapter {
    padding-block: clamp(78px, 9vw, 120px);
    border-top: 1px solid rgba(67, 91, 71, 0.15);
  }

  .feature-decay {
    padding-bottom: clamp(58px, 7vw, 82px);
  }

  .feature-copy {
    max-width: 470px;
  }

  .feature-number {
    margin: 0 0 18px;
    color: #8cab90;
    font-family: var(--serif);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
  }

  .feature-copy h3 {
    margin: 0;
    color: #262a27;
    font-family: var(--serif);
    font-size: clamp(2.25rem, 4vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .feature-prose p {
    margin: 0;
    color: #606761;
    font-size: clamp(0.94rem, 1.15vw, 1.05rem);
    line-height: 1.58;
  }

  .feature-prose p + p {
    margin-top: 14px;
  }

  .feature-copy > .feature-prose {
    margin-top: 24px;
  }

  .feature-cards,
  .feature-garden {
    display: grid;
    grid-template-columns: minmax(300px, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(48px, 7vw, 94px);
    align-items: center;
  }

  .feature-cards .feature-copy {
    order: 1;
  }

  .feature-cards .card-rail-visual {
    order: 2;
  }

  .feature-garden {
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, 0.82fr);
  }

  .feature-garden .garden-plot {
    order: 1;
  }

  .feature-garden .feature-copy {
    order: 2;
  }

  .card-rail-visual,
  .garden-plot {
    min-width: 0;
    padding: 24px;
    color: #e8ebe5;
    background:
      radial-gradient(circle at 70% 0%, rgba(134, 166, 130, 0.12), transparent 20rem),
      #262d29;
    border: 1px solid rgba(54, 67, 58, 0.16);
    border-radius: 26px;
    box-shadow: 0 24px 54px rgba(44, 51, 45, 0.17);
  }

  .card-rail-header,
  .garden-plot-header,
  .card-rail-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .card-rail-header,
  .garden-plot-header {
    padding: 0 4px 18px;
    font-size: 0.78rem;
    font-weight: 650;
  }

  .card-rail-header small,
  .garden-plot-header small {
    color: #9fa9a1;
    font-size: 0.65rem;
    font-weight: 500;
  }

  .card-rail {
    display: flex;
    gap: 12px;
    overflow: hidden;
    scroll-snap-type: x mandatory;
  }

  .sample-note-card {
    position: relative;
    flex: 0 0 min(245px, 58%);
    min-height: 285px;
    padding: 25px 20px 18px;
    color: #e8ebe5;
    background: #333a36;
    border: 1px solid rgba(235, 238, 229, 0.12);
    border-radius: 18px;
    scroll-snap-align: center;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.17);
  }

  .sample-note-card-active {
    border-color: rgba(148, 181, 143, 0.48);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.22), 0 0 0 1px rgba(148, 181, 143, 0.12);
  }

  .card-grip {
    position: absolute;
    top: 9px;
    left: 50%;
    color: #829087;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    transform: translateX(-50%);
  }

  .sample-note-card p {
    margin: 24px 0 0;
    font-family: var(--serif);
    font-size: 1.18rem;
    line-height: 1.35;
  }

  .sample-note-card footer {
    position: absolute;
    right: 18px;
    bottom: 16px;
    left: 18px;
    display: flex;
    justify-content: space-between;
    color: #96a099;
    font-size: 0.58rem;
  }

  .card-rail-footer {
    padding: 18px 4px 0;
    color: #8f9a92;
    font-size: 0.58rem;
  }

  .card-rail-footer strong {
    color: #b9c9b6;
    font-size: 0.62rem;
    font-weight: 650;
  }

  .garden-plot {
    width: min(100%, 590px);
    justify-self: start;
  }

  .garden-plot-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }

  .garden-plot-slot {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(235, 238, 229, 0.09);
    border-radius: 14px;
  }

  .garden-plot-slot img {
    width: 78%;
    height: 78%;
    object-fit: contain;
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.2));
  }

  .garden-plot-slot > small {
    position: absolute;
    right: 7px;
    bottom: 5px;
    color: #68736b;
    font-size: 0.48rem;
  }

  .garden-plot-slot-open {
    border-style: dashed;
  }

  .garden-plot-slot-open > span {
    color: #66736a;
    font-size: 1rem;
    font-weight: 300;
  }

  .garden-plot-hint {
    margin: 18px 0 0;
    color: #8f9a92;
