---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlantMark from "../components/PlantMark.astro";
import { SITE_ASSETS } from "../config";

const title = "LivingNotes | Big topics take time";
const description = "Some subjects need more than one sitting to make sense. LivingNotes helps you keep track of the pieces as you return to them.";

const collectionNames = [
  "Ideas", "Reading Notes", "Drafts", "Questions", "Research", "Recipes",
  "Projects", "Observations", "Someday", "Worth Keeping", "Private", "Inspiration",
  "Book Notes", "Experiments", "Loose Threads", "Field Notes", "Essays", "References",
  "Conversations", "Things I Learned", "Possibilities", "Fragments", "Sketches", "Plans",
  "Journal", "Places", "People", "Films", "Music", "Poems",
  "Design", "Work in Progress", "Good Questions", "Small Discoveries", "Arguments", "Sources",
  "Dreams", "Watch Later", "To Revisit", "Unfinished", "Connections", "Curiosities",
  "Project Seeds", "Daily Notes", "Study", "Travel", "Home", "Garden",
  "Writing", "Collected Lines", "Open Questions", "Notes to Self", "Future", "Remember",
  "New Directions", "Quiet Thoughts",
];

const plantCombinations = [0, 2, 3, 4, 5].flatMap((foliage) =>
  Array.from({ length: 5 }, (_, pot) => ({ foliage, pot })),
);

// Shuffle complete decks so every allowed design gets used before it repeats.
const shuffledPlantDeck = (seed: number) => {
  const deck = [...plantCombinations];
  let state = seed >>> 0;

  for (let index = deck.length - 1; index > 0; index -= 1) {
    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
    const swapIndex = state % (index + 1);
    [deck[index], deck[swapIndex]] = [deck[swapIndex], deck[index]];
  }

  return deck;
};

const collectionPlants = [
  ...shuffledPlantDeck(0x4c697669),
  ...shuffledPlantDeck(0x6e674e6f),
  ...shuffledPlantDeck(0x74657347),
]
  .slice(0, collectionNames.length)
  .map(({ foliage, pot }) => `/images/plants/plant_foliage-${foliage}_pot-${pot}_healthy.png`);

// A few fading plants hint at the decay mechanic without overwhelming the garden.
const decayingPlants = new Map([
  [5, 10],
  [16, 25],
  [29, 50],
  [35, 100],
  [50, 25],
]);

decayingPlants.forEach((decay, index) => {
  collectionPlants[index] = `/images/plants/plant_foliage-5_pot-4_decay-${decay}.png`;
});

const yellowingPlants = new Map([
  [8, "/images/plants/plant_foliage-2_pot-0_decay-25.png"],
  [14, "/images/plants/plant_foliage-3_pot-2_decay-25.png"],
  [20, "/images/plants/plant_foliage-4_pot-1_decay-25.png"],
  [27, "/images/plants/plant_foliage-5_pot-3_decay-25.png"],
  [32, "/images/plants/plant_foliage-3_pot-4_decay-50.png"],
  [33, "/images/plants/plant_foliage-4_pot-0_decay-50.png"],
  [44, "/images/plants/plant_foliage-2_pot-0_decay-25.png"],
  [52, "/images/plants/plant_foliage-4_pot-1_decay-25.png"],
]);

yellowingPlants.forEach((plant, index) => {
  collectionPlants[index] = plant;
});

const logoPlantPots = new Map([
  [2, 1],
  [12, 2],
  [23, 3],
  [34, 4],
  [47, 0],
  [54, 2],
]);

const plantFieldNames = Array.from(
  { length: 120 },
  (_, index) => collectionNames[index % collectionNames.length],
);

---

<BaseLayout {title} {description}>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="LivingNotes home">
      <span class="brand-mark"><PlantMark size={32} /></span>
      <span>LivingNotes</span>
    </a>
    <a class="header-link" href="#inside">Inside the app</a>
  </header>

  <main id="top">
    <section class="hero hero-centered shell" aria-labelledby="hero-title">
      <div class="halo halo-one" aria-hidden="true"></div>
      <div class="halo halo-two" aria-hidden="true"></div>
      <div class="hero-copy reveal">
        <h1 id="hero-title">Big topics<br /><span>take time</span></h1>
        <p class="lede">Saving notes helps. But with so many things competing for your attention, it’s easy to get lost in it all.</p>
        <p class="lede hero-answer">LivingNotes helps you find your way back.</p>
        <div class="hero-actions">
          <p class="launch-badge"><small>In development</small>Coming soon</p>
        </div>
      </div>
    </section>

    <section class="incubation decay-story" aria-label="How Decay works">
      <div class="shell incubation-inner">
        <article class="feature-chapter decay-intro-section" id="inside" aria-labelledby="decay-title">
          <div class="decay-story-copy">
            <h2 id="decay-title">
              <span>Introducing </span><span class="decay-word" aria-label="Decay">
                <span class="decay-letter" data-decay-letter>D</span>
                <span class="decay-letter" data-decay-letter>e</span>
                <span class="decay-letter" data-decay-letter>c</span>
                <span class="decay-letter" data-decay-letter>a</span>
                <span class="decay-letter" data-decay-letter>y</span>
              </span>
            </h2>
            <p>It’s easy to ignore saved notes you’ve already read.</p>
            <p>To jog your memory, Decay does something every few days: it makes a few characters look corrupted without changing the writing underneath.</p>
            <p class="decay-choice">Repair it, rewrite it, read it again, or decide it no longer needs your attention.</p>
          </div>

          <figure class="motion-demo ipad-decay-demo" data-motion-demo>
            <div class="feature-ipad ipad-recording-frame">
              <div class="motion-demo-frame ipad-recording-screen">
                <img
                  src={SITE_ASSETS.decayTabletAnimation.poster}
                  data-motion-image
                  data-animated-src={SITE_ASSETS.decayTabletAnimation.src}
                  data-poster-src={SITE_ASSETS.decayTabletAnimation.poster}
                  alt={SITE_ASSETS.decayTabletAnimation.alt}
                  width={SITE_ASSETS.decayTabletAnimation.width}
                  height={SITE_ASSETS.decayTabletAnimation.height}
                  loading="lazy"
                />
                <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="true" aria-label="Play iPad Decay animation">
                  <span aria-hidden="true" data-motion-icon>▶</span>
                </button>
              </div>
            </div>
            <figcaption>Decay doesn’t actually damage your note; it just gets you to look.</figcaption>
          </figure>
        </article>

        <article class="feature-chapter repair-section" aria-labelledby="repair-title">
          <div class="decay-story-copy">
            <h2 id="repair-title">How does it work?</h2>
            <p>Fixing Decay is easy. Press and hold a changed character and wait.</p>
            <p>No quiz. No review session. Just a simple fidget-toy mechanic that eases you back into an old note.</p>
            <p>From there, it’s up to you. You know what your notes mean and what they still need better than anyone else.</p>
          </div>

          <figure class="single-decay-demo" aria-label="An iPhone demonstrating press-and-hold Decay repair">
            <div class="hold-animation">
              <img class="hold-phone" src={SITE_ASSETS.decayWorkflow[1].src} alt={SITE_ASSETS.decayWorkflow[1].alt} width={SITE_ASSETS.decayWorkflow[1].width} height={SITE_ASSETS.decayWorkflow[1].height} loading="lazy" />
              <img class="hold-repaired" src={SITE_ASSETS.decayWorkflow[2].src} alt="" width={SITE_ASSETS.decayWorkflow[2].width} height={SITE_ASSETS.decayWorkflow[2].height} loading="lazy" aria-hidden="true" />
              <svg class="hold-progress" viewBox="0 0 1179 2556" preserveAspectRatio="none" aria-hidden="true">
                <rect pathLength="1" x="117" y="380" width="944" height="1967" rx="60" />
              </svg>
              <img class="hold-hand" src="/images/pointing-hand.png" alt="" width="512" height="512" loading="lazy" aria-hidden="true" />
            </div>
            <figcaption>It might even be a nice alternative to scrolling.</figcaption>
          </figure>
        </article>

        <article class="feature-chapter attention-section" aria-labelledby="attention-title">
          <div class="decay-story-copy">
            <h2 id="attention-title">Designed for Large Collections</h2>
            <p>Working through several big topics naturally creates a large collection. How do you keep it manageable as it grows?</p>
            <p>There are plenty of ways to approach that problem. LivingNotes builds its entire system around one familiar metaphor: gardening.</p>
            <p>Sections organize plants, plants hold related notes, and their changing appearance shows at a glance which topics receive your attention—and which ones you haven’t revisited in a while.</p>
          </div>

          <figure class="motion-demo mac-decay-demo" data-motion-demo>
            <div class="feature-mac mac-recording-frame">
              <div class="macbook-screen motion-demo-frame mac-recording-screen">
                <img
                  src={SITE_ASSETS.decayGardenAnimation.poster}
                  data-motion-image
                  data-animated-src={SITE_ASSETS.decayGardenAnimation.src}
                  data-poster-src={SITE_ASSETS.decayGardenAnimation.poster}
                  alt={SITE_ASSETS.decayGardenAnimation.alt}
                  width={SITE_ASSETS.decayGardenAnimation.width}
                  height={SITE_ASSETS.decayGardenAnimation.height}
                  loading="lazy"
                />
                <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="true" aria-label="Play plant yellowing animation">
                  <span aria-hidden="true" data-motion-icon>▶</span>
                </button>
              </div>
              <span class="macbook-base" aria-hidden="true"></span>
            </div>
            <figcaption>Sections contain plants. Plants contain notes.</figcaption>
          </figure>
        </article>
      </div>
    </section>

    <section class="product-section shell" aria-labelledby="inside-title">
      <div class="section-heading">
        <h2 id="inside-title">Deliberately simple</h2>
        <p class="section-description">LivingNotes doesn’t need to analyze your writing or store it on our servers. Your notes stay on your Apple devices and in your private iCloud account.</p>
        <p class="section-description section-description-followup">This means we can afford to offer LivingNotes as a one-time purchase.</p>
        <p class="footer-smile">:D</p>
        <p class="launch-badge launch-badge-light"><small>In development</small>Coming soon</p>
      </div>

      <div class="plant-field-window" role="img" aria-label="An expansive grid of LivingNotes plants continuing beyond the visible area">
        <div class="plant-field" aria-hidden="true">
          {plantFieldNames.map((name, index) => (
            <span class="collection-plant">
            {logoPlantPots.has(index) ? (
              <span class="logo-plant">
                <svg viewBox="0 0 624 648" fill="none">
                  <g transform="translate(139 218) scale(7.2)">
                    <path d="M24 35V18" stroke="#76513d" stroke-width="2.5" stroke-linecap="round" />
                    <path d="M24 26C17 26 12.5 22.3 12.5 16.2C19.3 15.4 23.8 18.8 24 26Z" fill="#76956f" />
                    <path d="M24 21.5C24.4 14.4 28.7 10.3 35.7 10.5C35.8 17 31.7 21.2 24 21.5Z" fill="#9ab08b" />
                    <path d="M24 18.5C21.1 15.9 21.3 12.5 23.4 9.2C26.8 11.4 27.7 14.8 24 18.5Z" fill="#b7c7a8" transform="rotate(-30 24 18.5)" />
                  </g>
                </svg>
                <img
                  src={`/images/plants/plant_foliage-0_pot-${logoPlantPots.get(index)}_healthy.png`}
                  alt=""
                  width="624"
                  height="648"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : (
              <img src={collectionPlants[index % collectionPlants.length]} alt="" width="624" height="648" loading="lazy" decoding="async" />
            )}
            <small>{name}</small>
            </span>
          ))}
        </div>
      </div>
    </section>

  </main>

  <footer class="site-footer shell">
    <a class="brand footer-brand" href="#top"><PlantMark size={27} /><span>LivingNotes</span></a>
    <nav class="footer-links" aria-label="Support and legal">
      <a href="/support/">Support</a>
      <a href="/terms/">Terms</a>
    </nav>
    <p>© {new Date().getFullYear()} LivingNotes</p>
  </footer>
</BaseLayout>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-hero-carousel]");

  carousels.forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-hero-slide]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-hero-dot]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeIndex = 0;
    let timer: number | undefined;

    const showSlide = (nextIndex: number) => {
      activeIndex = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });

      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        dot.classList.toggle("is-active", isActive);
        if (isActive) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    const stop = () => {
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (reduceMotion.matches) return;

      timer = window.setTimeout(() => {
        showSlide(activeIndex + 1);
        start();
      }, 3000);
    };

    dots.forEach((dot, index) => dot.addEventListener("click", () => {
      showSlide(index);
    }));

    carousel.addEventListener("focusin", stop);
    carousel.addEventListener("focusout", (event) => {
      if (!carousel.contains(event.relatedTarget as Node | null)) start();
    });
    reduceMotion.addEventListener("change", start);
    document.addEventListener("visibilitychange", () => document.hidden ? stop() : start());
    start();
  });

  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  const motionDemos = Array.from(document.querySelectorAll<HTMLElement>("[data-motion-demo]"));

  motionDemos.forEach((demo) => {
    const image = demo.querySelector<HTMLImageElement>("[data-motion-image]");
    const toggle = demo.querySelector<HTMLButtonElement>("[data-motion-toggle]");
    const icon = toggle?.querySelector<HTMLElement>("[data-motion-icon]");
    if (!image || !toggle || !icon) return;

    const animatedSource = image.dataset.animatedSrc;
    const posterSource = image.dataset.posterSrc;
    if (!animatedSource || !posterSource) return;

    let isVisible = false;
    let userPaused = false;

    const showPoster = () => {
      if (!image.src.endsWith(posterSource)) image.src = posterSource;
      toggle.setAttribute("aria-pressed", "true");
      toggle.setAttribute("aria-label", toggle.getAttribute("aria-label")?.replace("Pause", "Play") ?? "Play animation");
      icon.textContent = "▶";
    };

    const play = () => {
      if (motionPreference.matches || userPaused || !isVisible || document.hidden) {
        showPoster();
        return;
      }
      if (!image.src.endsWith(animatedSource)) image.src = animatedSource;
      toggle.setAttribute("aria-pressed", "false");
      toggle.setAttribute("aria-label", toggle.getAttribute("aria-label")?.replace("Play", "Pause") ?? "Pause animation");
      icon.textContent = "Ⅱ";
    };

    toggle.addEventListener("click", () => {
      const isPlaying = image.src.endsWith(animatedSource);
      userPaused = isPlaying;
      if (isPlaying) showPoster();
      else {
        userPaused = false;
        play();
      }
    });

    const observer = new IntersectionObserver((entries) => {
      isVisible = entries.some((entry) => entry.isIntersecting);
      if (isVisible) play();
      else showPoster();
    }, { rootMargin: "240px 0px" });

    observer.observe(demo);
    motionPreference.addEventListener("change", () => motionPreference.matches ? showPoster() : play());
    document.addEventListener("visibilitychange", () => document.hidden ? showPoster() : play());
  });

  const decayLetters = Array.from(document.querySelectorAll<HTMLElement>("[data-decay-letter]"));
  const decayMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const decayStyles = [
    { family: "ui-rounded, system-ui, sans-serif", weight: "800", style: "normal" },
    { family: "Georgia, ui-serif, serif", weight: "700", style: "italic" },
    { family: "ui-monospace, SFMono-Regular, Menlo, monospace", weight: "750", style: "normal" },
    { family: "'Snell Roundhand', 'Segoe Script', cursive", weight: "700", style: "normal" },
    { family: "'Noteworthy', 'Comic Sans MS', cursive", weight: "700", style: "normal" },
    { family: "Impact, Haettenschweiler, sans-serif", weight: "400", style: "normal" },
  ];
  const decayTimers = new Map<HTMLElement, number>();

  const applyDecayStyle = (letter: HTMLElement, styleIndex: number) => {
    const style = decayStyles[styleIndex % decayStyles.length];
    letter.style.fontFamily = style.family;
    letter.style.fontWeight = style.weight;
    letter.style.fontStyle = style.style;
    letter.style.setProperty("--decay-turn", `${((styleIndex * 3) % 7) - 3}deg`);
  };

  const stopDecayLetters = () => {
    decayTimers.forEach((timer) => window.clearTimeout(timer));
    decayTimers.clear();
  };

  const scheduleDecayLetter = (letter: HTMLElement, initialDelay = 0) => {
    let styleIndex = Math.floor(Math.random() * decayStyles.length);
    applyDecayStyle(letter, styleIndex);

    const advance = () => {
      if (decayMotion.matches || document.hidden) return;
      let nextIndex = styleIndex;
      while (nextIndex === styleIndex) nextIndex = Math.floor(Math.random() * decayStyles.length);
      styleIndex = nextIndex;
      applyDecayStyle(letter, styleIndex);
      const timer = window.setTimeout(advance, 450 + Math.random() * 850);
      decayTimers.set(letter, timer);
    };

    const timer = window.setTimeout(advance, initialDelay);
    decayTimers.set(letter, timer);
  };

  const startDecayLetters = () => {
    stopDecayLetters();
    decayLetters.forEach((letter, index) => {
      applyDecayStyle(letter, index);
      if (!decayMotion.matches) scheduleDecayLetter(letter, 120 + Math.random() * 700);
    });
  };

  decayMotion.addEventListener("change", startDecayLetters);
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) stopDecayLetters();
    else startDecayLetters();
  });
  startDecayLetters();
</script>

<style>
  .shell {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 92px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: #485d49;
    background: #d9dfce;
    border-radius: 50%;
  }

  .header-link {
    color: var(--ink-muted);
    font-size: 0.9rem;
    text-underline-offset: 5px;
    transition: color 160ms ease;
  }

  .header-link:hover {
    color: var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(480px, 1.12fr);
    gap: clamp(30px, 4vw, 72px);
    align-items: center;
    min-height: 700px;
    padding-block: 54px 72px;
  }

  .hero-copy {
    max-width: 560px;
    text-align: left;
  }

  .hero-copy .eyebrow,
  .hero-actions {
    justify-content: flex-start;
  }

  .hero-copy h1,
  .hero-copy .lede {
    margin-left: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    color: var(--sage-light);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .eyebrow > span {
    display: block;
    width: 26px;
    height: 1px;
    background: currentColor;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.99;
  }

  h1 {
    max-width: 620px;
    font-size: clamp(3.2rem, 5vw, 5.15rem);
  }

  h1 span {
    color: var(--sage-light);
    font-weight: 400;
  }

  .lede {
    max-width: 540px;
    margin: 34px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-copy .hero-answer {
    margin-top: 12px;
    color: var(--ink);
    font-weight: 650;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 38px;
  }

  .launch-badge {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 62px;
    padding: 11px 20px;
    color: #18221c;
    background: var(--ink);
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    gap: 3px;
    margin: 0;
  }

  .launch-badge small {
    color: #58625b;
    font-size: 0.63rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 560px;
  }

  .hero-carousel {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-carousel-viewport {
    position: relative;
    height: 510px;
  }

  .hero-slide {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transform: translate(-43%, -50%) rotate(var(--hero-device-tilt, 0deg));
    transition: opacity 650ms ease, transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, -50%) rotate(var(--hero-device-tilt, 0deg));
  }

