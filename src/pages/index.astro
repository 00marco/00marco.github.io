  }

  .footer-brand {
    color: #bec5bd;
    font-size: 0.88rem;
  }

  .footer-links {
    display: flex;
    gap: 22px;
  }

  .footer-links a {
    color: var(--ink-muted);
    text-underline-offset: 5px;
  }

  .reveal {
    animation: reveal 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
