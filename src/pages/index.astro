---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlantMark from "../components/PlantMark.astro";
import { SITE_ASSETS } from "../config";

const title = "LivingNotes — Give unfinished ideas time to grow";
const description = "A calm place to set thoughts aside, let them develop, and return before they fade. Coming soon for iPhone and iPad.";

const collectionNames = [
  "Songs", "Research ideas", "Joke ideas", "Movies", "Books", "Scripts",
  "Lecture notes", "Journal", "Recipes", "Home projects", "To-do", "Poems",
  "Story seeds", "Characters", "Experiments", "Questions", "Quotes", "Sketches",
  "Essays", "Articles", "Podcast ideas", "Game ideas", "Designs", "Trips",
  "Gift ideas", "Reading list", "Watchlist", "Classes", "Work notes", "Dreams",
  "Memories", "Garden", "Repairs", "Finances", "Health", "Habits",
  "Goals", "Events", "Letters", "Photos", "Inventions", "Side projects",
];

const decaySteps = [
  {
    title: "Notice the yellow",
    copy: "A yellowing plant signals that a collection needs attention.",
    image: SITE_ASSETS.decayWorkflow[0],
  },
  {
    title: "Open the note",
    copy: "Enter the collection and find the affected card.",
    image: SITE_ASSETS.decayWorkflow[1],
  },
  {
    title: "Hold the caterpillar",
    copy: "Press and hold it for two seconds to restore the hidden vowel.",
    image: SITE_ASSETS.decayWorkflow[2],
  },
  {
    title: "Read it whole again",
    copy: "The caterpillar disappears and the complete thought returns.",
    image: SITE_ASSETS.decayWorkflow[3],
  },
];
---

<BaseLayout {title} {description}>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="LivingNotes home">
      <span class="brand-mark"><PlantMark size={32} /></span>
      <span>LivingNotes</span>
    </a>
    <a class="header-link" href="#inside">Inside the app</a>
  </header>

  <main id="top">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span> A place for thoughts to wait</p>
        <h1 id="hero-title">Some ideas need<br /><em>time to take root.</em></h1>
        <p class="lede">LivingNotes is a parking lot for unfinished thoughts—a place to keep songs, stories, research questions, and experiments without forcing them to be finished before they’re ready.</p>
        <div class="hero-actions">
          <p class="launch-badge"><small>In development</small>Coming soon</p>
          <span class="platform-note">For iPhone and iPad</span>
        </div>
      </div>

      <div class="hero-visual reveal" aria-label="LivingNotes shown on iPhone">
        <div class="halo halo-one"></div>
        <div class="halo halo-two"></div>
        <figure class="phone-shot">
          <img src={SITE_ASSETS.heroPhone.src} alt={SITE_ASSETS.heroPhone.alt} width={SITE_ASSETS.heroPhone.width} height={SITE_ASSETS.heroPhone.height} fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="incubation" aria-labelledby="incubation-title">
      <div class="shell incubation-inner">
        <div class="phone-annotated">
          <p class="phone-label phone-label-card"><span>01</span>A clear place<br />for an idea to wait</p>
          <figure class="decay-phone">
            <img src={SITE_ASSETS.decayPhone.src} alt={SITE_ASSETS.decayPhone.alt} width={SITE_ASSETS.decayPhone.width} height={SITE_ASSETS.decayPhone.height} loading="lazy" />
          </figure>
          <p class="phone-label phone-label-decay"><span>02</span>Hold to clear decay<br />and reveal the thought</p>
        </div>

        <div class="incubation-copy">
          <p class="eyebrow eyebrow-dark"><span></span> Ideas don’t run on deadlines</p>
          <h2 id="incubation-title">You can’t rush a truly new idea.</h2>
          <p class="incubation-intro">Effort matters. But some things only become clear after you stop pushing: the missing lyric, the turn in a story, the research question worth asking, the experiment you haven’t quite found yet.</p>

          <div class="thought-examples" aria-label="Examples of ideas that need time">
            <span>A melody</span>
            <span>A story turn</span>
            <span>A research question</span>
            <span>An experiment</span>
          </div>

        </div>
      </div>
    </section>

    <section class="decay-workflow" aria-labelledby="decay-workflow-title">
      <div class="shell workflow-inner">
        <div class="workflow-heading">
          <p class="eyebrow"><span></span> A small reason to return</p>
          <h2 id="decay-workflow-title">Bring a fading thought back.</h2>
          <p>Decay turns revisiting a note into a brief, deliberate ritual.</p>
        </div>

        <ol class="workflow-steps">
          {decaySteps.map((step, index) => (
            <li class="workflow-step">
              <span class="step-marker" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <figure class="workflow-shot">
                <img src={step.image.src} alt={step.image.alt} width={step.image.width} height={step.image.height} loading="lazy" />
              </figure>
              <div class="step-copy">
                <h3>{step.title}</h3>
                <p>{step.copy}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="product-section shell" id="inside" aria-labelledby="inside-title">
      <div class="section-heading">
        <p class="eyebrow"><span></span> The card is the container</p>
        <h2 id="inside-title">Unfinished thoughts,<br />given a shape.</h2>
        <p>Cards keep ideas distinct without isolating them. Add what you know, leave room for what you don’t, and see the whole collection at once.</p>
      </div>

      <div class="plant-field" role="img" aria-label="A wide grid of LivingNotes plants fading softly toward its edges">
        {collectionNames.map((name, index) => (
          <span class={`collection-plant plant-${(index % 6) + 1}`} aria-hidden="true">
            <i class="leaf leaf-a"></i>
            <i class="leaf leaf-b"></i>
            <i class="leaf leaf-c"></i>
            <i class="leaf leaf-d"></i>
            <i class="stem"></i>
            <i class="pot"></i>
            <small>{name}</small>
          </span>
        ))}
      </div>
    </section>

    <section class="closing shell" aria-labelledby="closing-title">
      <div class="closing-mark" aria-hidden="true"><PlantMark size={82} /></div>
      <p class="eyebrow centered"><span></span> Begin with a thought <span></span></p>
      <h2 id="closing-title">Not every thought needs<br />an answer today.</h2>
      <p>LivingNotes is coming soon for iPhone and iPad.</p>
      <p class="launch-badge launch-badge-light"><small>In development</small>Coming soon</p>
    </section>
  </main>

  <footer class="site-footer shell">
    <a class="brand footer-brand" href="#top"><PlantMark size={27} /><span>LivingNotes</span></a>
    <nav class="footer-links" aria-label="Support and legal">
      <a href="/support/">Support</a>
      <a href="/terms/">Terms</a>
    </nav>
    <p>© {new Date().getFullYear()} LivingNotes</p>
  </footer>
</BaseLayout>

<style>
  .shell {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 92px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: #485d49;
    background: #d9dfce;
    border-radius: 50%;
  }

  .header-link {
    color: var(--ink-muted);
    font-size: 0.9rem;
    text-underline-offset: 5px;
    transition: color 160ms ease;
  }

  .header-link:hover {
    color: var(--ink);
  }

  .hero {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
    min-height: 760px;
    padding-block: 72px 94px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    color: var(--sage-light);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .eyebrow > span {
    display: block;
    width: 26px;
    height: 1px;
    background: currentColor;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.99;
  }

  h1 {
    max-width: 720px;
    font-size: clamp(4.2rem, 7vw, 7.3rem);
  }

  h1 em {
    color: var(--sage-light);
    font-weight: 400;
  }

  .lede {
    max-width: 540px;
    margin: 34px 0 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 38px;
  }

  .launch-badge {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 62px;
    padding: 11px 20px;
    color: #18221c;
    background: var(--ink);
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    gap: 3px;
    margin: 0;
  }

  .launch-badge small {
    color: #58625b;
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .platform-note {
    color: #8f9790;
    font-size: 0.78rem;
  }

  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 640px;
  }

  .halo {
    position: absolute;
    border: 1px solid rgba(168, 190, 158, 0.13);
    border-radius: 50%;
  }

  .halo-one {
    width: 610px;
    height: 610px;
  }

  .halo-two {
    width: 470px;
    height: 470px;
  }

  .phone-shot {
    position: relative;
    z-index: 2;
    width: min(330px, 67%);
    margin: 0;
    padding: 9px;
    background: #111513;
    border: 1px solid rgba(236, 239, 230, 0.25);
    border-radius: 44px;
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    transform: rotate(2.5deg);
  }

  .phone-shot img {
    border-radius: 35px;
  }

  .incubation {
    color: #26302a;
    background:
      radial-gradient(circle at 50% 42%, rgba(155, 202, 161, 0.2), transparent 24rem),
      #f7f5ef;
  }

  .incubation-inner {
    display: grid;
    grid-template-columns: minmax(440px, 500px) minmax(0, 1fr);
    gap: clamp(38px, 5vw, 76px);
    align-items: center;
    padding-block: 78px;
  }

  .eyebrow-dark {
    justify-content: flex-start;
    color: #68816a;
  }

  .incubation h2 {
    max-width: 650px;
    color: #262a27;
    font-size: clamp(2.35rem, 4vw, 4.2rem);
    line-height: 0.98;
  }

  .incubation-intro {
    max-width: 620px;
    margin: 22px 0 0;
    color: #606761;
    font-size: clamp(0.96rem, 1.25vw, 1.08rem);
    line-height: 1.55;
  }

  .thought-examples {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 8px;
    margin: 24px 0 28px;
  }

  .thought-examples span {
    padding: 7px 11px;
    color: #526454;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(67, 91, 71, 0.14);
    border-radius: 999px;
    font-size: 0.72rem;
  }

  .phone-annotated {
    position: relative;
    width: 100%;
    min-height: 610px;
    display: grid;
    place-items: center;
  }

  .decay-phone {
    width: min(300px, 64%);
    margin: 0 auto;
    filter: drop-shadow(0 24px 28px rgba(28, 36, 30, 0.18));
  }

  .decay-phone img {
    width: 100%;
  }

  .phone-label {
    position: absolute;
    z-index: 1;
    margin: 0;
    color: #527158;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .phone-label span {
    display: block;
    margin-bottom: 4px;
    color: #8cab90;
    font-family: var(--serif);
    font-size: 0.82rem;
    font-weight: 400;
  }

  .phone-label::after {
    position: absolute;
    top: 30px;
    width: 54px;
    height: 1px;
    background: #80a486;
    content: "";
  }

  .phone-label::before {
    position: absolute;
    top: 27px;
    width: 7px;
    height: 7px;
    background: #80a486;
    border-radius: 50%;
    content: "";
  }

  .phone-label-card {
    bottom: 27%;
    left: -18px;
    text-align: right;
  }

  .phone-label-card::after {
    left: calc(100% + 10px);
  }

  .phone-label-card::before {
    left: calc(100% + 61px);
  }

  .phone-label-decay {
    top: 31%;
    right: -18px;
    text-align: left;
  }

  .phone-label-decay::after {
    right: calc(100% + 10px);
  }

  .phone-label-decay::before {
    right: calc(100% + 61px);
  }

  .decay-workflow {
    background:
      radial-gradient(circle at 50% 10%, rgba(115, 149, 112, 0.13), transparent 34rem),
      #202723;
    border-top: 1px solid rgba(235, 238, 229, 0.1);
    border-bottom: 1px solid var(--line);
  }

  .workflow-inner {
    padding-block: 104px 112px;
  }

  .workflow-heading {
    max-width: 720px;
    margin-bottom: 58px;
  }

  .workflow-heading h2 {
    max-width: 680px;
    font-size: clamp(2.65rem, 4.8vw, 4.8rem);
    line-height: 1;
  }

  .workflow-heading > p:last-child {
    margin: 22px 0 0;
    color: var(--ink-muted);
    font-size: clamp(0.96rem, 1.25vw, 1.08rem);
    line-height: 1.55;
  }

  .workflow-steps {
    --workflow-gap: clamp(18px, 2.4vw, 32px);
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--workflow-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .workflow-step {
    position: relative;
    min-width: 0;
  }

  .step-marker {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-bottom: 18px;
    color: #dfe7dc;
    background: #526b56;
    border: 1px solid rgba(214, 226, 210, 0.28);
    border-radius: 50%;
    font-family: var(--serif);
    font-size: 0.75rem;
  }

  .workflow-step:not(:last-child)::after {
    position: absolute;
    z-index: 1;
    top: 17px;
    right: calc(-1 * var(--workflow-gap));
    left: 33px;
    height: 1px;
    background: rgba(177, 197, 176, 0.28);
    content: "";
  }

  .workflow-step:not(:last-child)::before {
    position: absolute;
    z-index: 2;
    top: 14px;
    right: calc(-1 * var(--workflow-gap));
    width: 6px;
    height: 6px;
    border-top: 1px solid rgba(177, 197, 176, 0.48);
    border-right: 1px solid rgba(177, 197, 176, 0.48);
    content: "";
    transform: rotate(45deg);
  }

  .workflow-shot {
    width: 100%;
    margin: 0;
    padding: 7px;
    background: #111513;
    border: 1px solid rgba(236, 239, 230, 0.17);
    border-radius: 24px;
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.24);
    overflow: hidden;
  }

  .workflow-shot img {
    width: 100%;
    aspect-ratio: 917 / 1715;
    background: #1e2220;
    border-radius: 17px;
    object-fit: cover;
  }

  .step-copy {
    padding: 22px 4px 0;
  }

  .step-copy h3 {
    margin: 0 0 9px;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .step-copy p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .product-section {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(480px, 1.18fr);
    gap: clamp(48px, 7vw, 100px);
    align-items: center;
    min-height: 766px;
    padding-block: 78px;
    border-top: 1px solid var(--line);
  }

  .section-heading {
    display: block;
    margin: 0;
  }

  .section-heading .eyebrow {
    margin-bottom: 22px;
  }

  .section-heading h2 {
    font-size: clamp(2.65rem, 4.3vw, 4.6rem);
    line-height: 1;
  }

  .section-heading > p:last-child {
    max-width: 480px;
    margin: 24px 0 0;
    color: var(--ink-muted);
    font-size: clamp(0.96rem, 1.25vw, 1.08rem);
    line-height: 1.55;
  }

  .plant-field {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(7, 1fr);
    gap: 18px 16px;
    width: 100%;
    height: 610px;
    padding: 18px;
    overflow: hidden;
    background: radial-gradient(circle at center, rgba(67, 91, 71, 0.08), transparent 68%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 38%, rgba(0, 0, 0, 0.82) 61%, transparent 95%);
    mask-image: radial-gradient(ellipse at center, #000 38%, rgba(0, 0, 0, 0.82) 61%, transparent 95%);
  }

  .collection-plant {
    position: relative;
    display: block;
    width: 58px;
    height: 58px;
    place-self: center;
    transform: scale(var(--plant-scale, 1));
  }

  .collection-plant i {
    position: absolute;
    display: block;
  }

  .collection-plant .leaf {
    z-index: 2;
    width: 25px;
    height: 14px;
    background: linear-gradient(145deg, #789477, #526c57);
    border-radius: 8px;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.13), 0 4px 8px rgba(0, 0, 0, 0.13);
  }

  .leaf-a { top: 7px; left: 17px; }
  .leaf-b { top: 18px; left: 7px; transform: rotate(-4deg); }
  .leaf-c { top: 18px; right: 5px; transform: rotate(5deg); }
  .leaf-d { top: 28px; left: 17px; }

  .collection-plant .stem {
    z-index: 1;
    top: 24px;
    left: 28px;
    width: 3px;
    height: 20px;
    background: #5f6d51;
  }

  .collection-plant .pot {
    bottom: 2px;
    left: 18px;
    width: 24px;
    height: 12px;
    background: linear-gradient(#796a5e 0 25%, #5f534c 25%);
    border-radius: 2px 2px 7px 7px;
  }

  .collection-plant small {
    position: absolute;
    top: 62px;
    left: 50%;
    width: 86px;
    color: #8f9991;
    font-size: 0.56rem;
    font-weight: 500;
    line-height: 1.15;
    text-align: center;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .plant-2 { --plant-scale: 0.82; }
  .plant-3 { --plant-scale: 1.08; }
  .plant-4 { --plant-scale: 0.72; }
  .plant-5 { --plant-scale: 0.92; }
  .plant-6 { --plant-scale: 1.14; }

  .plant-3 .leaf-a,
  .plant-6 .leaf-c {
    background: linear-gradient(145deg, #a3a25c, #6d8258);
  }

  .plant-4 .leaf-d,
  .plant-6 .leaf-b {
    background: linear-gradient(145deg, #a7653e, #7d5f44);
  }

  .closing {
    display: grid;
    justify-items: center;
    padding-block: 134px 142px;
    text-align: center;
  }

  .closing-mark {
    display: grid;
    place-items: center;
    width: 116px;
    height: 116px;
    margin-bottom: 40px;
    color: #5c785d;
    background: rgba(194, 207, 184, 0.1);
    border: 1px solid rgba(194, 207, 184, 0.17);
    border-radius: 50%;
  }

  .centered {
    margin-bottom: 26px;
  }

  .closing h2 {
    max-width: 880px;
  }

  .closing > p:not(.eyebrow) {
    margin: 28px 0 30px;
    color: var(--ink-muted);
  }

  .launch-badge-light {
    min-width: 230px;
    align-items: center;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: 104px;
    border-top: 1px solid var(--line);
    color: #7f8881;
    font-size: 0.76rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer p:last-child {
    text-align: right;
  }

  .footer-brand {
    color: #bec5bd;
    font-size: 0.88rem;
  }

  .footer-links {
    display: flex;
    gap: 22px;
  }

  .footer-links a {
    color: var(--ink-muted);
    text-underline-offset: 5px;
  }

  .reveal {
    animation: reveal 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero-visual.reveal {
    animation-delay: 100ms;
  }

  @keyframes reveal {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1000px) {
    .workflow-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 52px;
    }

    .workflow-step:nth-child(2)::before,
    .workflow-step:nth-child(2)::after {
      display: none;
    }

    .workflow-shot {
      max-width: 340px;
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 76px;
    }

    .hero-copy {
      max-width: 720px;
    }

    .hero-visual {
      min-height: 680px;
    }

    .phone-shot {
      width: 320px;
    }

